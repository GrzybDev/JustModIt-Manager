<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
    <!-- Lock files must describe the runtime graph that publishing restores, or locked restores fail in CI. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- CsWin32 generates structures whose layout differs by architecture, such as the tray icon's, only for a known one. -->
    <PlatformTarget>x64</PlatformTarget>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Each app embeds the texts of its one language, so satellite assemblies from packages are left out. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Copyright>Copyright © 2026 Marek Grzyb</Copyright>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
  </PropertyGroup>

  <!-- Build settings of every app, overridden per build with -p:Name=value. Each app compiles them into its
       ProductConfiguration together with its Product.props. -->
  <PropertyGroup>
    <ManagerApiKey Condition="'$(ManagerApiKey)' == ''"></ManagerApiKey>
    <ManagerErrorReportsDsn Condition="'$(ManagerErrorReportsDsn)' == ''"></ManagerErrorReportsDsn>
    <!-- A development build uses its own data folder, mutexes and pipe, so it never touches an installed copy. -->
    <ManagerDevelopmentBuild Condition="'$(ManagerDevelopmentBuild)' == '' and '$(Configuration)' == 'Release'">false</ManagerDevelopmentBuild>
    <ManagerDevelopmentBuild Condition="'$(ManagerDevelopmentBuild)' == ''">true</ManagerDevelopmentBuild>
    <!-- Added to a development build's names; a copy that runs beside the developer's own build takes another one. -->
    <ManagerDevelopmentName Condition="'$(ManagerDevelopmentName)' == ''">Dev</ManagerDevelopmentName>
    <!-- Autostart and the link scheme are registered by installed copies; a developer testing links turns this on. -->
    <ManagerDevelopmentShellIntegration Condition="'$(ManagerDevelopmentShellIntegration)' == ''">false</ManagerDevelopmentShellIntegration>
  </PropertyGroup>
</Project>
