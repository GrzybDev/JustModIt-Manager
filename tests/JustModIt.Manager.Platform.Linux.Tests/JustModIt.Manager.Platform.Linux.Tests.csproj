<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\JustModIt.Manager.Platform.Linux\JustModIt.Manager.Platform.Linux.csproj" />
    <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
  </ItemGroup>

  <!-- The fake peers on the tests' own bus answer the same interfaces the app calls and call the ones it serves. The
       generator writes its internal handler base into every assembly it runs in, so the tests' own copy hides the one they
       see in Platform.Linux, and names the proxy of dbusmenu as its interface does, in lower case. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0436;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\src\JustModIt.Manager.Platform.Linux\DBus\*.xml" Namespace="JustModIt.Manager.Platform.Linux.Tests.DBus"
                     DBusGeneratorMode="Handler" />
    <AdditionalFiles Include="..\..\src\JustModIt.Manager.Platform.Linux\DBus\Served\*.xml"
                     Namespace="JustModIt.Manager.Platform.Linux.Tests.DBus" DBusGeneratorMode="Proxy" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\QuietSystemEvents.cs" Link="Shared\QuietSystemEvents.cs" />
  </ItemGroup>

  <!-- The games of this machine that the live tests use, named in a file that git leaves out. -->
  <ItemGroup>
    <Compile Include="..\Shared\LiveGames.cs" Link="Shared\LiveGames.cs" />
    <None Include="..\live-games.json" Link="live-games.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\live-games.json')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Eventually.cs" Link="Shared\Eventually.cs" />
    <Using Include="JustModIt.Manager.Tests" />
  </ItemGroup>
</Project>
