<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built as an app: its Product.props gives the tests the real site's settings, so no address lives in test code. -->
  <Import Project="..\..\src\MenadzerSpolszczen\Product.props" />
  <Import Project="..\..\src\JustModIt.Manager.Host\ProductConfiguration.targets" />

  <PropertyGroup>
    <ManagerDevelopmentName>LiveTests</ManagerDevelopmentName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JustModIt.Manager.Core\JustModIt.Manager.Core.csproj" />
    <ProjectReference Include="..\..\src\JustModIt.Manager.Creator\JustModIt.Manager.Creator.csproj" />
    <ProjectReference Include="..\..\src\JustModIt.Manager.Platform.Windows\JustModIt.Manager.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- The games of this machine that the live tests use, named in a file that git leaves out. -->
  <ItemGroup>
    <Compile Include="..\Shared\LiveGames.cs" Link="Shared\LiveGames.cs" />
    <None Include="..\live-games.json" Link="live-games.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\live-games.json')" />
  </ItemGroup>
</Project>
