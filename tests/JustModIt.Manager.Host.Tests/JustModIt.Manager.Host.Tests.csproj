<Project Sdk="Microsoft.NET.Sdk">
  <!-- An invented app's Product.props, so the tests read the ProductConfiguration its build generates. -->
  <PropertyGroup>
    <Product>Example "App"; 100%</Product>
    <ManagerAppId>ExampleApp</ManagerAppId>
    <ManagerVendorId>ExampleVendor</ManagerVendorId>
    <ManagerAppSlug>example-app</ManagerAppSlug>
    <ManagerPackageExtension>.examplemod</ManagerPackageExtension>
    <ManagerCreatorProjectExtension>.exampleproj</ManagerCreatorProjectExtension>
    <ManagerApiUrl>https://api.example.com/</ManagerApiUrl>
    <ManagerTargetLanguage>de</ManagerTargetLanguage>
    <ManagerAppProject>true</ManagerAppProject>
  </PropertyGroup>

  <Import Project="..\..\src\JustModIt.Manager.Host\ProductConfiguration.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\JustModIt.Manager.Host\JustModIt.Manager.Host.csproj" />
  </ItemGroup>
</Project>
