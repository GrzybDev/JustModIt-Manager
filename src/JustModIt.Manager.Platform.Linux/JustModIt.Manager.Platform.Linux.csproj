<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\native\avifshim.targets" />

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="DBus/*.xml" Namespace="JustModIt.Manager.Platform.Linux.DBus" DBusGeneratorMode="Proxy" />
    <!-- logind's manager has the class name of systemd's. -->
    <AdditionalFiles Update="DBus/org.freedesktop.login1.Manager.xml" Namespace="JustModIt.Manager.Platform.Linux.DBus.Login" />
    <!-- The objects the app serves itself, such as its tray icon. -->
    <AdditionalFiles Include="DBus/Served/*.xml" Namespace="JustModIt.Manager.Platform.Linux.DBus" DBusGeneratorMode="Handler" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustModIt.Manager.Core\JustModIt.Manager.Core.csproj" />
  </ItemGroup>
</Project>
