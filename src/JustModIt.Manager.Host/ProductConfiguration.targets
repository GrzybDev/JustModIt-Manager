<Project>
  <!-- Constants instead of AppContext data or assembly metadata: NativeAOT keeps them without reflection or config files. -->
  <Target Name="GenerateProductConfiguration" BeforeTargets="CoreCompile">
    <!-- Players unpack a .zip into the game by hand, which spills a manifest package's payload folders there. -->
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ManagerPackageExtension)', '^\.[A-Za-z0-9]+$'))
                      or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ManagerCreatorProjectExtension)', '^\.[A-Za-z0-9]+$'))
                      or '$(ManagerPackageExtension)' == '.zip' or '$(ManagerCreatorProjectExtension)' == '$(ManagerPackageExtension)'"
           Text="ManagerPackageExtension and ManagerCreatorProjectExtension must be two different extensions, each a dot followed by letters or digits, and packages cannot use .zip." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ManagerDevelopmentName)', '^[A-Za-z0-9]+$'))"
           Text="ManagerDevelopmentName must be letters or digits." />
    <PropertyGroup>
      <_ProductConfigurationFile>$(IntermediateOutputPath)ProductConfiguration.g.cs</_ProductConfigurationFile>
      <_DevelopmentBuildLiteral>false</_DevelopmentBuildLiteral>
      <_DevelopmentBuildLiteral Condition="'$(ManagerDevelopmentBuild)' == 'true'">true</_DevelopmentBuildLiteral>
      <!-- Keys belong to the release and CI channels; a development build uses the API as anyone does, whatever it is passed. -->
      <_ApiKey>$(ManagerApiKey)</_ApiKey>
      <_ApiKey Condition="'$(ManagerDevelopmentBuild)' == 'true'"></_ApiKey>
      <!-- A development build's crashes are the developer's own, never the players' reports. -->
      <_ErrorReportsDsn>$(ManagerErrorReportsDsn)</_ErrorReportsDsn>
      <_ErrorReportsDsn Condition="'$(ManagerDevelopmentBuild)' == 'true'"></_ErrorReportsDsn>
      <_DevelopmentShellIntegrationLiteral>false</_DevelopmentShellIntegrationLiteral>
      <_DevelopmentShellIntegrationLiteral Condition="'$(ManagerDevelopmentShellIntegration)' == 'true'">true</_DevelopmentShellIntegrationLiteral>
      <!-- Only an app references Host, whose type this member builds; test projects get the constants alone. -->
      <_ProductSettingsMember Condition="'$(ManagerAppProject)' == 'true'"><![CDATA[

    /// <summary>The values above, as the shared startup takes them.</summary>
    public static global::JustModIt.Manager.Host.ProductSettings Settings { get%3B } = new()
    {
        ProductName = ProductName,
        AppId = AppId,
        VendorId = VendorId,
        AppSlug = AppSlug,
        PackageExtension = PackageExtension,
        CreatorProjectExtension = CreatorProjectExtension,
        ApiUrl = ApiUrl,
        SiteUrl = SiteUrl,
        ApiKey = ApiKey,
        ErrorReportsDsn = ErrorReportsDsn,
        UpdateUrl = UpdateUrl,
        UpdateChannel = UpdateChannel,
        SourceUrl = SourceUrl,
        IssuesUrl = IssuesUrl,
        Language = Language,
        TargetLanguage = TargetLanguage,
        AccentColor = AccentColor,
        ImageHosts = ImageHosts,
        IsDevelopmentBuild = IsDevelopmentBuild,
        DevelopmentName = DevelopmentName,
        DevelopmentShellIntegration = DevelopmentShellIntegration,
    }%3B]]></_ProductSettingsMember>
      <_ProductConfigurationSource><![CDATA[// <auto-generated/>
namespace $(RootNamespace)%3B

/// <summary>The app's Product.props and the Manager* build settings, fixed when the app was built.</summary>
internal static class ProductConfiguration
{
    public const string ProductName = @"$([MSBuild]::Escape($(Product.Replace('"', '""'))))"%3B

    /// <summary>Names the exe, the data folder, the mutexes and the pipe.</summary>
    public const string AppId = @"$([MSBuild]::Escape($(ManagerAppId.Replace('"', '""'))))"%3B

    /// <summary>The folder above the data folder.</summary>
    public const string VendorId = @"$([MSBuild]::Escape($(ManagerVendorId.Replace('"', '""'))))"%3B

    /// <summary>The link scheme and, with a leading dot, the hidden backup folder in game folders.</summary>
    public const string AppSlug = @"$([MSBuild]::Escape($(ManagerAppSlug.Replace('"', '""'))))"%3B

    /// <summary>The extension, with its dot, of the app's manifest packages, a format every app shares.</summary>
    public const string PackageExtension = @"$([MSBuild]::Escape($(ManagerPackageExtension.Replace('"', '""'))))"%3B

    /// <summary>The extension, with its dot, of the package creator's project files.</summary>
    public const string CreatorProjectExtension = @"$([MSBuild]::Escape($(ManagerCreatorProjectExtension.Replace('"', '""'))))"%3B

    public const string ApiUrl = @"$([MSBuild]::Escape($(ManagerApiUrl.Replace('"', '""'))))"%3B

    public const string SiteUrl = @"$([MSBuild]::Escape($(ManagerSiteUrl.Replace('"', '""'))))"%3B

    /// <summary>An empty key means the API is used anonymously.</summary>
    public const string ApiKey = @"$([MSBuild]::Escape($(_ApiKey.Replace('"', '""'))))"%3B

    /// <summary>The Sentry DSN that error reports go to, or empty for none.</summary>
    public const string ErrorReportsDsn = @"$([MSBuild]::Escape($(_ErrorReportsDsn.Replace('"', '""'))))"%3B

    /// <summary>An empty address turns self-update off.</summary>
    public const string UpdateUrl = @"$([MSBuild]::Escape($(ManagerUpdateUrl.Replace('"', '""'))))"%3B

    public const string UpdateChannel = @"$([MSBuild]::Escape($(ManagerUpdateChannel.Replace('"', '""'))))"%3B

    /// <summary>The repository holding the app's source code, or empty for none.</summary>
    public const string SourceUrl = @"$([MSBuild]::Escape($(ManagerSourceUrl.Replace('"', '""'))))"%3B

    /// <summary>Where players report a problem, given the app's and the system's version as a body parameter, or empty for nowhere.</summary>
    public const string IssuesUrl = @"$([MSBuild]::Escape($(ManagerIssuesUrl.Replace('"', '""'))))"%3B

    /// <summary>The UI language, an IETF tag, or empty for English.</summary>
    public const string Language = @"$([MSBuild]::Escape($(ManagerLanguage.Replace('"', '""'))))"%3B

    /// <summary>
    /// The language the site's projects add to games (an ISO 639-1 code), or empty. A game that already offers it
    /// officially is not changed automatically.
    /// </summary>
    public const string TargetLanguage = @"$([MSBuild]::Escape($(ManagerTargetLanguage.Replace('"', '""'))))"%3B

    public const string AccentColor = @"$([MSBuild]::Escape($(ManagerAccentColor.Replace('"', '""'))))"%3B

    /// <summary>The hosts, separated by semicolons, that the window loads images from, each alone or with the path its images are under.</summary>
    public const string ImageHosts = @"$([MSBuild]::Escape($(ManagerImageHosts.Replace('"', '""'))))"%3B

    public const bool IsDevelopmentBuild = $(_DevelopmentBuildLiteral)%3B

    /// <summary>What a development build adds to its names, so copies built with different ones never meet.</summary>
    public const string DevelopmentName = @"$(ManagerDevelopmentName)"%3B

    /// <summary>A development build registers autostart and the link scheme, which otherwise only an installed copy does.</summary>
    public const bool DevelopmentShellIntegration = $(_DevelopmentShellIntegrationLiteral)%3B$(_ProductSettingsMember)
}
]]></_ProductConfigurationSource>
    </PropertyGroup>

    <WriteLinesToFile File="$(_ProductConfigurationFile)" Lines="$(_ProductConfigurationSource)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(_ProductConfigurationFile)" />
      <FileWrites Include="$(_ProductConfigurationFile)" />
    </ItemGroup>
  </Target>
</Project>
