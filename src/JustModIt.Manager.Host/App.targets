<Project>
  <!-- What every app's exe shares. The app imports its Product.props before this file and references Host itself. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>$(ManagerAppId)</AssemblyName>
    <ApplicationManifest>$(MSBuildThisFileDirectory)app.manifest</ApplicationManifest>
    <ApplicationIcon>Branding\app.ico</ApplicationIcon>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <ManagerAppProject>true</ManagerAppProject>
  </PropertyGroup>

  <!-- SelfContained is left to publish time: a self-contained exe cannot be referenced by a test project (NETSDK1151). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)ProductConfiguration.targets" />
  <Import Project="$(MSBuildThisFileDirectory)..\JustModIt.Manager.Localization\Texts.targets" />
</Project>
