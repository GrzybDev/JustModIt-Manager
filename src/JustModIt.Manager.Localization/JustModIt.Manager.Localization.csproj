<Project Sdk="Microsoft.NET.Sdk">
  <!-- Only the English base is embedded here, as the fallback; the translations reach an app through Texts.targets. -->
  <ItemGroup>
    <EmbeddedResource Remove="Resources\Strings.*.resx" />
    <None Include="Resources\Strings.*.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessageFormat" />
  </ItemGroup>

  <!-- The resource generator would read the texts of this assembly only; Strings reads the app's through Text. -->
  <Target Name="GenerateStrings" BeforeTargets="CoreCompile">
    <XmlPeek XmlInputPath="Resources\Strings.resx" Query="/root/data/@name">
      <Output TaskParameter="Result" ItemName="_TextName" />
    </XmlPeek>

    <PropertyGroup>
      <_StringsFile>$(IntermediateOutputPath)Strings.g.cs</_StringsFile>
      <_StringsSource><![CDATA[// <auto-generated/>
namespace JustModIt.Manager.Localization%3B

/// <summary>The app's texts, one property for each text of the English base.</summary>
public static class Strings
{
@(_TextName->'    public static string %(Identity) => Text.Lookup(nameof(%(Identity)))%3B', '%0A')
}
]]></_StringsSource>
    </PropertyGroup>

    <WriteLinesToFile File="$(_StringsFile)" Lines="$(_StringsSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(_StringsFile)" />
      <FileWrites Include="$(_StringsFile)" />
    </ItemGroup>
  </Target>
</Project>
