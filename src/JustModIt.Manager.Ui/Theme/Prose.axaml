<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="using:JustModIt.Manager.Ui.Controls.Markdown"
        xmlns:ui="using:JustModIt.Manager.Ui.Controls">
  <!-- The site's texts laid out by MarkdownView: 15/26 prose, 14/22 with Classes="compact" for notes beside the page. -->

  <Style Selector="md|MarkdownView md|ProseText">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
  </Style>
  <Style Selector="md|MarkdownView md|ProseText.heading">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector="md|MarkdownView md|ProseText.subheading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="md|MarkdownView Run.strong">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="md|MarkdownView Run.link">
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>
  <Style Selector="md|MarkdownView Run.code">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    <Setter Property="Background" Value="{StaticResource FillStrongBrush}" />
  </Style>
  <Style Selector="md|MarkdownView Border.bullet">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="#59FFFFFF" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>
  <Style Selector="md|MarkdownView TextBlock.listNumber">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="md|MarkdownView Border.quote">
    <Setter Property="BorderBrush" Value="{StaticResource FillStrongerBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="14,0,0,0" />
  </Style>
  <Style Selector="md|MarkdownView Border.code">
    <Setter Property="Background" Value="{StaticResource FillSubtleBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="md|MarkdownView TextBlock.code">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
  </Style>
  <Style Selector="md|MarkdownView Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
  </Style>
  <Style Selector="md|MarkdownView Border.picture">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- A YouTube film: its still under a play mark, opened in the browser like the gallery's films. -->
  <Style Selector="md|MarkdownView Button.film">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
  </Style>
  <Style Selector="md|MarkdownView Button.film:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
  </Style>
  <Style Selector="md|MarkdownView Button.film Border.play">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="#B8030712" />
    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="md|MarkdownView Button.film Border.play ui|Icon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Margin" Value="3,0,0,0" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="md|MarkdownView Border.cell, md|MarkdownView Border.headCell">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="md|MarkdownView Border.headCell md|ProseText">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style Selector="md|MarkdownView.compact md|ProseText, md|MarkdownView.compact TextBlock.listNumber">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="22" />
  </Style>
  <Style Selector="md|MarkdownView.compact Border.bullet">
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
</Styles>
