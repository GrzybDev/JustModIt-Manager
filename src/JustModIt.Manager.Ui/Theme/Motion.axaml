<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:JustModIt.Manager.Ui.Controls">
  <!-- Looping animations. The window has the class "loops" only while it can be seen and the system allows motion
       (MainWindow.UpdateMotion), so every loop sits under it and stops with it. Classes: pulse (a glow breathing),
       bob, bob2 and bob3 (drifting on periods that never meet), spin (a busy icon). -->

  <Style Selector=":is(Window).loops :is(Control).pulse">
    <Style.Animations>
      <Animation Duration="0:0:2.4" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.55" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector=":is(Window).loops :is(Control).bob">
    <Style.Animations>
      <Animation Duration="0:0:2.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="RenderTransform" Value="translateY(0px)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RenderTransform" Value="translateY(-7px)" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector=":is(Window).loops :is(Control).bob2">
    <Style.Animations>
      <Animation Duration="0:0:3.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="RenderTransform" Value="translateY(-6px)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RenderTransform" Value="translateY(2px)" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector=":is(Window).loops :is(Control).bob3">
    <Style.Animations>
      <Animation Duration="0:0:3.8" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="RenderTransform" Value="translateY(1px) rotate(-4deg)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RenderTransform" Value="translateY(-6px) rotate(4deg)" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector=":is(Control).spin">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>
  <Style Selector=":is(Window).loops :is(Control).spin">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RenderTransform" Value="rotate(360deg)" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Phase loops of the controls drawn from a phase: the skeleton's sweep, the indeterminate bar's segment, the ring. -->
  <Style Selector=":is(Window).loops ui|Skeleton">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Phase" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Phase" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Window).loops ProgressBar:indeterminate /template/ ui|ProgressStripe">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite" Easing="CubicEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Phase" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Phase" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- With motion stopped the segment rests in the middle of the track, still saying "working". -->
  <Style Selector="ProgressBar:indeterminate /template/ ui|ProgressStripe">
    <Setter Property="Phase" Value="0.55" />
  </Style>
  <Style Selector=":is(Window).loops ui|ProgressRing">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Phase" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Phase" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
