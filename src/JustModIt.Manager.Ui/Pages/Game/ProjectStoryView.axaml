<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:game="using:JustModIt.Manager.Ui.Pages.Game"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:md="using:JustModIt.Manager.Ui.Controls.Markdown"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Game.ProjectStoryView"
             x:DataType="game:ProjectStory">
  <UserControl.Styles>
    <Style Selector="Border.genre">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{StaticResource FillBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.galleryTile">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.galleryTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Border.play">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="#B8030712" />
      <Setter Property="BorderBrush" Value="#2EFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.films">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#D1030712" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border#Description">
      <Setter Property="MaxHeight" Value="234" />
    </Style>
    <Style Selector="Border#Description.open">
      <Setter Property="MaxHeight" Value="Infinity" />
    </Style>
    <Style Selector="Border#Description.long:not(.open)">
      <Setter Property="OpacityMask">
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Color="Black" Offset="0.6" />
          <GradientStop Color="Transparent" Offset="1" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <!-- Beside what the game is about while the page is wide, under it once it is narrow. -->
    <Style Selector="StackPanel#Creators">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Width" Value="360" />
      <Setter Property="Margin" Value="48,0,0,0" />
    </Style>
    <Style Selector="StackPanel#Creators.stacked">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,48,0,0" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="56">
    <StackPanel Spacing="20" IsVisible="{Binding HasGallery}">
      <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowsGalleryTitle}">
        <TextBlock Classes="h2" Text="{x:Static loc:Strings.GamePage_Gallery}" />
        <TextBlock Text="{Binding GalleryText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                   Margin="0,4,0,0" />
      </StackPanel>
      <ItemsControl x:Name="Gallery" ItemsSource="{Binding GalleryTiles}" Height="263">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid ColumnDefinitions="2*,*,*" RowDefinitions="*,*" ColumnSpacing="12" RowSpacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ItemsControl#Gallery > ContentPresenter" x:DataType="game:GalleryTile">
            <Setter Property="Grid.Row" Value="{Binding Row}" />
            <Setter Property="Grid.Column" Value="{Binding Column}" />
            <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
            <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="game:GalleryTile">
            <Button Classes="galleryTile" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Item.Caption}"
                    Command="{Binding $parent[UserControl].((game:ProjectStory)DataContext).OpenGalleryCommand}" CommandParameter="{Binding}">
              <Border CornerRadius="11" ClipToBounds="True">
                <Panel>
                  <ui:RemoteImage Source="{Binding Item.Image}" Fallback="{Binding Item.Fallback}"
                                  IsBlurred="{Binding $parent[UserControl].((game:ProjectStory)DataContext).IsBlurred}" />
                  <Border Classes="play" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsVisible="{Binding IsLargeFilm}">
                    <ui:Icon Data="{x:Static theme:Icons.Play}" Width="22" Height="22" Foreground="White" Margin="3,0,0,0" />
                  </Border>
                  <Border Classes="play" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                          IsVisible="{Binding IsSmallFilm}">
                    <ui:Icon Data="{x:Static theme:Icons.Play}" Width="12" Height="12" Foreground="White" Margin="2,0,0,0" />
                  </Border>
                  <Panel IsVisible="{Binding IsFirst}">
                    <Border Classes="films" IsVisible="{Binding $parent[UserControl].((game:ProjectStory)DataContext).ShowsFilms}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding $parent[UserControl].((game:ProjectStory)DataContext).FilmsText}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <ui:Icon Data="{x:Static theme:Icons.ArrowUpRight}" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}"
                                 VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Panel>
                </Panel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Grid x:Name="Sections" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
      <StackPanel Spacing="16" IsVisible="{Binding HasAbout}">
        <WrapPanel ItemSpacing="12" LineSpacing="8">
          <TextBlock Classes="h2" Text="{x:Static loc:Strings.GamePage_About}" />
          <ItemsControl ItemsSource="{Binding Details.Genres}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static loc:Strings.GamePage_Genres}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Classes="genre">
                  <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>
        <Border x:Name="Description" ClipToBounds="True" Classes.open="{Binding IsDescriptionOpen}" Classes.long="{Binding LongDescription}">
          <md:MarkdownView Document="{Binding Details.Description}" LinkCommand="{Binding OpenCommand}" />
        </Border>
        <Button Classes="quiet" HorizontalAlignment="Left" Margin="-12,-4,0,0" IsVisible="{Binding LongDescription}"
                Command="{Binding ToggleDescriptionCommand}" Content="{Binding IsDescriptionOpen, Converter={x:Static game:ProjectStoryView.MoreOrLess}}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.ChevronDown}" ui:ButtonAssist.IconAfter="True" />
        <md:MarkdownView Document="{Binding Details.Disclaimer}" Classes="compact" Opacity="0.85" IsVisible="{Binding HasDisclaimer}"
                         LinkCommand="{Binding OpenCommand}" />
      </StackPanel>
      <StackPanel x:Name="Creators" Spacing="16" IsVisible="{Binding HasTeam}">
        <TextBlock Classes="h2" Text="{x:Static loc:Strings.GamePage_Creators}" />
        <Border Classes="aside">
          <StackPanel Spacing="16">
            <Button Classes="inlineLink" Command="{Binding OpenCommand}" CommandParameter="{Binding TeamPage}" AutomationProperties.Name="{Binding TeamName}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ui:TeamBadge NameText="{Binding TeamName}" Avatar="{Binding TeamAvatar}" Width="44" Height="44" CornerRadius="10" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding TeamName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="{Binding TeamFacts}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Details.Support}" IsVisible="{Binding HasSupport}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="game:SupportLink">
                  <Button Classes="outline" HorizontalAlignment="Left" Command="{Binding $parent[UserControl].((game:ProjectStory)DataContext).OpenCommand}"
                          CommandParameter="{Binding Address}" Content="{Binding Platform, Converter={x:Static game:ProjectStoryView.SupportText}}"
                          ui:ButtonAssist.Icon="{x:Static theme:Icons.Coffee}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="14" IsVisible="{Binding HasCredits}">
              <Border Classes="divider" />
              <TextBlock Classes="overline" Text="{x:Static game:ProjectStory.CreditsTitle}" />
              <ItemsControl ItemsSource="{Binding Details.Credits}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" ColumnSpacing="20" RowSpacing="16" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="game:CreditView">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Role}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
