<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:JustModIt.Manager.Ui.Pages"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.PlaceholderPage"
             x:DataType="pages:PlaceholderPageViewModel">
  <ScrollViewer Classes="page">
    <StackPanel Classes="page">
      <ui:PageHeader Title="{Binding Title}" />
      <ui:EmptyState Classes="neutral" Icon="{Binding Icon}" Title="{x:Static loc:Strings.Shell_PlaceholderTitle}"
                     Message="{x:Static loc:Strings.Shell_PlaceholderMessage}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
