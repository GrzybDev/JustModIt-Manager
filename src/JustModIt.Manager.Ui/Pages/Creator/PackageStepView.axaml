<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.PackageStepView"
             x:DataType="creator:PackageStepViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="4">
      <Panel>
        <TextBlock Classes="h2" Text="{x:Static loc:Strings.Creator_BuildHeading}" IsVisible="{Binding !IsBuilt}" />
        <TextBlock Classes="h2" Text="{x:Static loc:Strings.Creator_BuiltHeading}" IsVisible="{Binding IsBuilt}" />
      </Panel>
      <TextBlock Classes="lead" Text="{Binding Description.Lead}" IsVisible="{Binding !IsBuilt}" />
    </StackPanel>

    <!-- Before the build: the format the plan needs and the package's metadata. -->
    <creator:DescriptionTab IsVisible="{Binding !IsBuilt}" />

    <!-- The build: its button, then its progress in the same place. -->
    <WrapPanel IsVisible="{Binding ShowsBuild}" ItemSpacing="20" LineSpacing="16">
      <Button x:Name="BuildButton" Classes="primary" Content="{x:Static loc:Strings.Creator_Build}" ui:ButtonAssist.Icon="{x:Static theme:Icons.Package}"
              Command="{Binding BuildCommand}" />
      <TextBlock Classes="caption" MaxWidth="560" VerticalAlignment="Center" Text="{Binding BuildHint}" />
      <Button Classes="quiet" Content="{x:Static loc:Strings.Creator_BuildElsewhere}" ui:ButtonAssist.Icon="{x:Static theme:Icons.FolderOpen}"
              IsVisible="{Binding ReusesTarget}" Command="{Binding BuildElsewhereCommand}" />
    </WrapPanel>
    <Border x:Name="Building" Classes="creatorCard" Padding="24,20" IsVisible="{Binding IsBuilding}" theme:Motion.Enter="True">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Classes="workChip">
            <ui:Icon Classes="spin" Data="{x:Static theme:Icons.LoaderCircle}" Width="20" Height="20" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{x:Static loc:Strings.Creator_BuildingTitle}" FontSize="15" LineHeight="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextStrongBrush}" />
            <TextBlock Classes="caption" Text="{Binding BuildTarget}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="outline headerAction" Content="{x:Static loc:Strings.Dialog_Cancel}" Command="{Binding CancelBuildCommand}" />
        </Grid>
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Classes="meta" Foreground="{StaticResource TextBodyBrush}" Text="{Binding Stage}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Classes="meta" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="{Binding Percent}" />
          </Grid>
          <ProgressBar Maximum="100" Value="{Binding Progress}" AutomationProperties.Name="{x:Static loc:Strings.Creator_BuildingTitle}" />
          <TextBlock Classes="pathLine" Text="{Binding FileLine}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ui:Callout Classes="danger" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.CircleX}"
                Title="{Binding ProblemTitle}" Message="{Binding ProblemText}" IsVisible="{Binding HasProblem}" theme:Motion.Enter="True">
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding BuildFindings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="creator:FindingLine">
              <Border Classes="buildFinding" Classes.accepted="{Binding IsAccepted}" Margin="0,0,0,4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Panel VerticalAlignment="Center">
                    <ui:Icon Data="{x:Static theme:Icons.TriangleAlert}" Width="16" Height="16" Classes="warningText" IsVisible="{Binding !IsAccepted}" />
                    <ui:Icon Data="{x:Static theme:Icons.CircleCheck}" Width="16" Height="16" Classes="successText" IsVisible="{Binding IsAccepted}" />
                  </Panel>
                  <TextBlock Grid.Column="1" Classes="rowText" LineHeight="20" VerticalAlignment="Center" Foreground="{StaticResource TextEmphasisBrush}"
                             Text="{Binding Text}" />
                  <Button Grid.Column="2" Classes="outline small" Content="{x:Static loc:Strings.Creator_AcceptWork}" IsVisible="{Binding CanAcknowledge}"
                          Command="{Binding $parent[UserControl].((creator:PackageStepViewModel)DataContext).AcceptCommand}"
                          CommandParameter="{Binding AcknowledgementKey}" />
                  <Border Grid.Column="2" Classes="kind success" VerticalAlignment="Center" IsVisible="{Binding IsAccepted}" theme:Motion.Enter="True">
                    <StackPanel>
                      <ui:Icon Data="{x:Static theme:Icons.Check}" />
                      <TextBlock Text="{x:Static loc:Strings.Creator_Accepted}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="primary compact" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_CompareAgain}" IsVisible="{Binding NeedsComparison}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.RefreshCw}" Command="{Binding CompareAgainCommand}" />
        <Button Classes="primary compact" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_Rebuild}" IsVisible="{Binding AcceptedAll}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.RefreshCw}" Command="{Binding BuildCommand}" theme:Motion.Enter="True" />
      </StackPanel>
    </ui:Callout>

    <!-- The package: the one just built, or after a failed build the earlier one, said to be earlier. -->
    <Border Classes="creatorCard" Padding="24,20" IsVisible="{Binding ShowsPackage}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <Border Classes="kind" Classes.success="{Binding IsBuilt}" Width="48" Height="48" CornerRadius="12" Padding="0" HorizontalAlignment="Center">
          <Panel HorizontalAlignment="Center">
            <ui:Icon Data="{x:Static theme:Icons.CircleCheck}" Width="24" Height="24" IsVisible="{Binding IsBuilt}" />
            <ui:Icon Data="{x:Static theme:Icons.Clock}" Width="24" Height="24" IsVisible="{Binding HasEarlierPackage}" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Classes="overline" Text="{Binding EarlierText}" IsVisible="{Binding HasEarlierPackage}" />
          <WrapPanel ItemSpacing="10">
            <TextBlock Text="{Binding ResultName}" FontSize="17" LineHeight="24" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}" />
            <Border Classes="kind" VerticalAlignment="Center">
              <TextBlock Text="{Binding ResultSize}" />
            </Border>
          </WrapPanel>
          <TextBlock Classes="meta" Text="{Binding ResultDetails}" TextWrapping="Wrap" />
          <TextBlock Classes="pathLine" Text="{Binding ResultFolder}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ResultFolder}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="outline" Content="{x:Static loc:Strings.Creator_Reveal}" ui:ButtonAssist.Icon="{x:Static theme:Icons.FolderOpen}"
                Command="{Binding RevealCommand}" />
      </Grid>
    </Border>

    <!-- After the build: what the site would say, and what comes next. -->
    <StackPanel Spacing="20" IsVisible="{Binding IsBuilt}">
      <ItemsControl ItemsSource="{Binding SiteWarnings}" IsVisible="{Binding HasSiteWarnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <ui:Callout Classes="warning" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.TriangleAlert}"
                        Title="{x:Static loc:Strings.Creator_SiteWarningTitle}" Message="{Binding}" Margin="0,0,0,8" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="12">
        <TextBlock Classes="overline" Text="{x:Static creator:PackageStepView.NextOverline}" />
        <Border Classes="creatorCard" ClipToBounds="True">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="20,18">
              <Panel VerticalAlignment="Top">
                <Border Classes="number" IsVisible="{Binding !WasTested}">
                  <TextBlock Text="1" />
                </Border>
                <Border Classes="number done" IsVisible="{Binding WasTested}">
                  <ui:Icon Data="{x:Static theme:Icons.Check}" Width="14" Height="14" />
                </Border>
              </Panel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding TestTitle}" FontSize="15" LineHeight="22" FontWeight="SemiBold" />
                <TextBlock Classes="bodyText" MaxWidth="760" HorizontalAlignment="Left" Text="{Binding TestText}"
                           Classes.dangerText="{Binding HasTestProblem}" />
                <StackPanel Spacing="8" Margin="0,10,0,0" IsVisible="{Binding IsTestRunning}">
                  <TextBlock Classes="meta" Foreground="{StaticResource TextBodyBrush}" Text="{Binding TestProgress}" />
                  <ProgressBar Classes="thin" Maximum="1" MaxWidth="420" HorizontalAlignment="Left" Value="{Binding TestFraction}"
                               IsIndeterminate="{Binding TestFraction, Converter={x:Static ObjectConverters.IsNull}}"
                               AutomationProperties.Name="{Binding TestProgress}" />
                </StackPanel>
                <WrapPanel ItemSpacing="12" LineSpacing="8" Margin="0,10,0,0">
                  <Button x:Name="TestButton" Classes="primary compact" Content="{x:Static loc:Strings.Creator_TestInstall}" IsVisible="{Binding OffersTestInstall}"
                          ui:ButtonAssist.Icon="{x:Static theme:Icons.Download}" Command="{Binding InstallTestCommand}" />
                  <Button Classes="primary compact" Content="{x:Static loc:Strings.Creator_Launch}" ui:ButtonAssist.Icon="{x:Static theme:Icons.Play}"
                          Command="{Binding LaunchCommand}">
                    <Button.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsTestInstalled" />
                        <Binding Path="CanLaunch" />
                      </MultiBinding>
                    </Button.IsVisible>
                  </Button>
                  <Button x:Name="UndoTestButton" Classes="outline" Content="{x:Static loc:Strings.Creator_UndoTest}" IsVisible="{Binding IsTestInstalled}"
                          ui:ButtonAssist.Icon="{x:Static theme:Icons.RotateCcw}" Command="{Binding UndoTestCommand}" />
                  <Button Classes="quiet" Content="{x:Static loc:Strings.Creator_TestAgain}" IsVisible="{Binding WasTested}"
                          ui:ButtonAssist.Icon="{x:Static theme:Icons.Download}" Command="{Binding InstallTestCommand}" />
                </WrapPanel>
                <Button x:Name="TestTogether" Classes="link" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Content="{x:Static loc:Strings.Creator_TestTogether}" IsVisible="{Binding OffersTestInstall}"
                        Command="{Binding InstallTestTogetherCommand}" />
              </StackPanel>
            </Grid>
            <Border Classes="divider" Opacity="0.6" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="20,18">
              <Border Classes="number" VerticalAlignment="Top">
                <TextBlock Text="2" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Static loc:Strings.Creator_PublishTitle}" FontSize="15" LineHeight="22" FontWeight="SemiBold" />
                <TextBlock Classes="bodyText" MaxWidth="760" HorizontalAlignment="Left" Text="{Binding PublishText}" />
                <!-- Once the package was tried in the game, publishing it is the next thing to do. -->
                <Button Classes="link" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_OpenDashboard}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.ExternalLink}" Command="{Binding OpenSiteCommand}" IsVisible="{Binding !WasTested}" />
                <Button Classes="primary compact" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_OpenDashboard}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.ExternalLink}" ui:ButtonAssist.IconAfter="True" Command="{Binding OpenSiteCommand}"
                        IsVisible="{Binding WasTested}" />
              </StackPanel>
            </Grid>
            <StackPanel IsVisible="{Binding ShowsSaveHint}">
              <Border Classes="divider" Opacity="0.6" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="20,18">
                <Border Classes="number" VerticalAlignment="Top">
                  <TextBlock Text="3" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{x:Static loc:Strings.Creator_SaveProjectTitle}" FontSize="15" LineHeight="22" FontWeight="SemiBold" />
                  <TextBlock Classes="bodyText" MaxWidth="760" HorizontalAlignment="Left" Text="{x:Static loc:Strings.Creator_SaveProjectText}" />
                </StackPanel>
              </Grid>
            </StackPanel>
            <Border Classes="divider" Opacity="0.6" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="20,18">
              <Border Classes="number" VerticalAlignment="Top">
                <TextBlock Text="{Binding FinishNumber}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Static loc:Strings.Creator_FinishTitle}" FontSize="15" LineHeight="22" FontWeight="SemiBold" />
                <TextBlock Classes="bodyText" MaxWidth="760" HorizontalAlignment="Left" Text="{Binding FinishText}" />
                <Button x:Name="FinishButton" Classes="outline" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_Finish}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.CheckCheck}" IsEnabled="{Binding CanRebuild}" Command="{Binding FinishCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <WrapPanel ItemSpacing="12" LineSpacing="8">
        <TextBlock Classes="meta" FontSize="14" VerticalAlignment="Center" Text="{x:Static loc:Strings.Creator_RebuildQuestion}" IsVisible="{Binding CanRebuild}" />
        <Button x:Name="RebuildButton" Classes="quiet" Content="{x:Static loc:Strings.Creator_Rebuild}" ui:ButtonAssist.Icon="{x:Static theme:Icons.RefreshCw}"
                IsEnabled="{Binding CanRebuild}" Command="{Binding BuildCommand}" />
        <Button Classes="quiet" Content="{x:Static loc:Strings.Creator_BuildElsewhere}" ui:ButtonAssist.Icon="{x:Static theme:Icons.FolderOpen}"
                IsVisible="{Binding CanRebuild}" Command="{Binding BuildElsewhereCommand}" />
        <TextBlock Classes="meta" MaxWidth="640" TextWrapping="Wrap" VerticalAlignment="Center" Text="{x:Static loc:Strings.Creator_RebuildBlocked}"
                   IsVisible="{Binding !CanRebuild}" />
      </WrapPanel>
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
      <Button Classes="outline footerAction" Content="{x:Static loc:Strings.Creator_Back}" ui:ButtonAssist.Icon="{x:Static theme:Icons.ArrowLeft}"
              Command="{Binding BackCommand}" IsEnabled="{Binding !IsBuilding}" />
    </Grid>
  </StackPanel>
</UserControl>
