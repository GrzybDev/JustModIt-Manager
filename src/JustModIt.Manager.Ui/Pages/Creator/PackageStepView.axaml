<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.PackageStepView"
             x:DataType="creator:PackageStepViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="4">
      <Panel>
        <TextBlock Classes="h2" Text="{x:Static loc:Strings.Creator_BuildHeading}" IsVisible="{Binding !Build.IsBuilt}" />
        <TextBlock Classes="h2" Text="{x:Static loc:Strings.Creator_BuiltHeading}" IsVisible="{Binding Build.IsBuilt}" />
      </Panel>
      <TextBlock Classes="lead" Text="{Binding Description.Lead}" IsVisible="{Binding !Build.IsBuilt}" />
    </StackPanel>

    <!-- Before the build: the format the plan needs and the package's metadata. -->
    <creator:DescriptionTab IsVisible="{Binding !Build.IsBuilt}" />

    <creator:BuiltCard />

    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
      <Button Classes="outline footerAction" Content="{x:Static loc:Strings.Creator_Back}" ui:ButtonAssist.Icon="{x:Static theme:Icons.ArrowLeft}"
              Command="{Binding BackCommand}" IsEnabled="{Binding !Build.IsBuilding}" />
    </Grid>
  </StackPanel>
</UserControl>
