<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.ProjectPage"
             x:DataType="creator:ProjectPageViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://JustModIt.Manager.Ui/Pages/Creator/CreatorStyles.axaml" />
  </UserControl.Styles>

  <!-- The page, and beside it, or over it in a narrow window, the panel of the cell chosen in the table. -->
  <Grid ColumnDefinitions="*,Auto">
    <!-- The head and the tabs, the tab in its own scroll, and the bar pinned under it, so the build is always in sight. -->
    <Grid RowDefinitions="Auto,*,Auto" MaxWidth="{StaticResource PageMaxWidth}" Margin="40,28,40,20" RowSpacing="16">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Border Classes="cover" Width="44" Height="58" CornerRadius="6" VerticalAlignment="Center">
            <Panel>
              <ui:Icon Data="{x:Static theme:Icons.Gamepad}" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}" />
              <ui:RemoteImage Source="{Binding Game.Cover, FallbackValue={x:Null}}" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <WrapPanel ItemSpacing="6" TextElement.FontSize="13">
              <Button x:Name="Breadcrumb" Classes="link" FontSize="13" Content="{x:Static loc:Strings.Creator_Projects}"
                      Command="{Binding Services.Navigator.GoBackCommand}" VerticalAlignment="Center" />
              <ui:Icon Data="{x:Static theme:Icons.ChevronRight}" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="pathLine" Text="{Binding ProjectName}" MaxWidth="360" VerticalAlignment="Center" IsVisible="{Binding !IsPartView}" />
              <Button Classes="link" FontSize="13" Content="{Binding ProjectName}" MaxWidth="360" VerticalAlignment="Center"
                      Command="{Binding ShowReleaseCommand}" IsVisible="{Binding IsPartView}" />
              <ui:Icon Data="{x:Static theme:Icons.ChevronRight}" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                       IsVisible="{Binding IsPartView}" />
              <TextBlock Classes="pathLine" Text="{Binding PartName}" VerticalAlignment="Center" IsVisible="{Binding IsPartView}" />
            </WrapPanel>
            <TextBlock Classes="pageTitle" Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="pathLine" Text="{Binding VersionLine}" ToolTip.Tip="{x:Static loc:Strings.Creator_BuildChecked}" />
          </StackPanel>
        </Grid>

        <!-- The project's views, on a row of their own, since beside the title they would not fit the smallest window. A tab tells how
             many files the software changes and how many of them have a problem. -->
        <Border Classes="tabs" HorizontalAlignment="Left" IsVisible="{Binding HasVersion}">
          <StackPanel Orientation="Horizontal" Spacing="4" AutomationProperties.Name="{x:Static loc:Strings.Creator_ProjectViews}">
            <RadioButton x:Name="ReleaseTab" Theme="{StaticResource SortPill}" GroupName="projectTab" Content="{x:Static loc:Strings.Creator_TabRelease}"
                         IsChecked="{Binding Tab, Converter={x:Static ui:ChoiceConverter.Instance}, ConverterParameter={x:Static creator:ProjectTab.Release}}" />
            <RadioButton x:Name="RuntimeTab" Theme="{StaticResource SortPill}" GroupName="projectTab" AutomationProperties.Name="{x:Static loc:Strings.Creator_RuntimeTitle}"
                         IsChecked="{Binding Tab, Converter={x:Static ui:ChoiceConverter.Instance}, ConverterParameter={x:Static creator:ProjectTab.Runtime}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Creator_RuntimeTitle}" VerticalAlignment="Center" />
                <Border Classes="kind" VerticalAlignment="Center" IsVisible="{Binding !!Review.RuntimeRows.Count}">
                  <TextBlock Text="{Binding Review.RuntimeCount}" />
                </Border>
                <Border Classes="kind danger" VerticalAlignment="Center" IsVisible="{Binding Review.HasRuntimeProblems}">
                  <TextBlock Text="{Binding Review.RuntimeProblems}" />
                </Border>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="DescriptionTab" Theme="{StaticResource SortPill}" GroupName="projectTab" Content="{x:Static loc:Strings.Creator_Metadata}"
                         IsChecked="{Binding Tab, Converter={x:Static ui:ChoiceConverter.Instance}, ConverterParameter={x:Static creator:ProjectTab.Description}}" />
          </StackPanel>
        </Border>

        <ui:Callout Classes="danger" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.CircleX}"
                    Title="{Binding ProblemTitle}" Message="{Binding ProblemText}" IsVisible="{Binding HasProblem}"
                    theme:Motion.Enter="True">
          <Button Classes="quiet small" Content="{x:Static loc:Strings.Creator_DismissProblem}" HorizontalAlignment="Left"
                  Margin="-12,0,0,0" Command="{Binding ClearProblemCommand}" />
        </ui:Callout>
      </StackPanel>

      <!-- While a build runs the project stands still, so its stamps and packages are the project's as the run read it. -->
      <ScrollViewer Grid.Row="1" Margin="-4,0,-16,0" Padding="4,0,16,0">
        <Panel>
          <!-- A project imported without a game has nothing to compare yet. -->
          <Border x:Name="NoVersion" Classes="creatorCard" Padding="28" Margin="0,4,0,16" VerticalAlignment="Top" IsVisible="{Binding !HasVersion}">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <Border Classes="iconChip" Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center">
                <ui:Icon Data="{x:Static theme:Icons.Gamepad}" Width="26" Height="26" />
              </Border>
              <TextBlock Classes="h4" HorizontalAlignment="Center" Text="{x:Static creator:ReleaseTab.NoVersionTitle}" />
              <TextBlock Classes="bodyText" HorizontalAlignment="Center" TextAlignment="Center" Text="{x:Static loc:Strings.Creator_NoVersionText}" />
              <Button Classes="primary" HorizontalAlignment="Center" Margin="0,6,0,0" Content="{x:Static loc:Strings.Creator_AddGameVersion}"
                      ui:ButtonAssist.Icon="{x:Static theme:Icons.Plus}" Command="{Binding AddVersionCommand}" />
            </StackPanel>
          </Border>
          <TransitioningContentControl x:Name="TabContent" Content="{Binding TabContent}" IsTransitionReversed="{Binding IsGoingBack}"
                                       ClipToBounds="False">
            <TransitioningContentControl.IsEnabled>
              <!-- The release tab freezes all but choosing a cell by itself. -->
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="!Build.IsBuilding" />
                <Binding Path="Tab" Converter="{x:Static ui:ChoiceConverter.Instance}" ConverterParameter="{x:Static creator:ProjectTab.Release}" />
              </MultiBinding>
            </TransitioningContentControl.IsEnabled>
            <TransitioningContentControl.PageTransition>
              <theme:PageTransition IsHorizontal="True" Offset="28" />
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>
        </Panel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Spacing="12" IsVisible="{Binding HasVersion}">
        <!-- A build's failure, with the warnings only the build finds, stands above the bar. -->
        <ui:Callout Classes="danger" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.CircleX}"
                    Title="{Binding Build.ProblemTitle}" Message="{Binding Build.ProblemText}" IsVisible="{Binding Build.HasProblem}" theme:Motion.Enter="True">
          <StackPanel Spacing="8">
            <ItemsControl ItemsSource="{Binding Build.BuildFindings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="creator:FindingLine">
                  <Border Classes="buildFinding" Classes.accepted="{Binding IsAccepted}" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Panel VerticalAlignment="Center">
                        <ui:Icon Data="{x:Static theme:Icons.TriangleAlert}" Width="16" Height="16" Classes="warningText" IsVisible="{Binding !IsAccepted}" />
                        <ui:Icon Data="{x:Static theme:Icons.CircleCheck}" Width="16" Height="16" Classes="successText" IsVisible="{Binding IsAccepted}" />
                      </Panel>
                      <TextBlock Grid.Column="1" Classes="rowText" LineHeight="20" VerticalAlignment="Center" Foreground="{StaticResource TextEmphasisBrush}"
                                 Text="{Binding Text}" />
                      <Button Grid.Column="2" Classes="outline small accept" Content="{x:Static loc:Strings.Creator_Accept}" IsVisible="{Binding CanAcknowledge}"
                              Command="{Binding $parent[UserControl].((creator:ProjectPageViewModel)DataContext).Review.AcceptCommand}"
                              CommandParameter="{Binding AcknowledgementKey}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAccepted}" theme:Motion.Enter="True">
                        <Border Classes="kind success" VerticalAlignment="Center">
                          <StackPanel>
                            <ui:Icon Data="{x:Static theme:Icons.Check}" />
                            <TextBlock Text="{x:Static loc:Strings.Creator_Accepted}" />
                          </StackPanel>
                        </Border>
                        <Button Classes="outline small undoAccept" Content="{x:Static loc:Strings.Creator_UndoAccept}"
                                Command="{Binding $parent[UserControl].((creator:ProjectPageViewModel)DataContext).Review.UndoAcceptCommand}"
                                CommandParameter="{Binding AcknowledgementKey}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="primary compact" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_Rebuild}" IsVisible="{Binding Build.AcceptedAll}"
                    ui:ButtonAssist.Icon="{x:Static theme:Icons.RefreshCw}" Command="{Binding Build.BuildCommand}" theme:Motion.Enter="True" />
          </StackPanel>
        </ui:Callout>

        <!-- The bar: what the build needs, where the packages go, the release's version and the build itself. -->
        <Border x:Name="BuildBar" Classes="buildBar">
          <Panel>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8" IsVisible="{Binding !Build.IsBuilding}">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" FontSize="14" Text="{Binding FormatLine}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FormatLine}" />
                <TextBlock Classes="caption" Text="{Binding FormatReason}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding FormatReason}"
                           IsVisible="{Binding FormatReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="{x:Static loc:Strings.Creator_Version}" VerticalAlignment="Center" />
                <TextBox x:Name="BarVersion" Width="96" Text="{Binding Description.Version}"
                         Classes.faulty="{Binding Description.Version, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                         AutomationProperties.Name="{x:Static loc:Strings.Creator_Version}" />
                <Button x:Name="BuildButton" Classes="primary" Content="{Binding BuildText}" ui:ButtonAssist.Icon="{x:Static theme:Icons.Package}"
                        Command="{Binding Build.BuildCommand}" IsEnabled="{Binding CanBuild}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                <WrapPanel ItemSpacing="12" LineSpacing="4">
                  <TextBlock Classes="rowTitle" FontSize="13" Text="{x:Static loc:Strings.Creator_BeforeBuild}" VerticalAlignment="Center" />
                  <ItemsControl x:Name="BeforeItems" ItemsSource="{Binding BeforeItems}" AutomationProperties.Name="{x:Static loc:Strings.Creator_BeforeBuild}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="14" LineSpacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="creator:BeforeItem">
                        <Panel>
                          <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding Command, Converter={x:Static ObjectConverters.IsNull}}">
                            <ui:Icon Data="{x:Static theme:Icons.Check}" Width="14" Height="14" Classes="successText" IsVisible="{Binding IsMet}" />
                            <ui:Icon Data="{x:Static theme:Icons.X}" Width="14" Height="14" Classes="dangerText" IsVisible="{Binding IsMissing}" />
                            <ui:Icon Data="{x:Static theme:Icons.CircleHelp}" Width="14" Height="14" Foreground="{StaticResource InfoTextBrush}" IsVisible="{Binding IsReminder}" />
                            <ui:Icon Data="{x:Static theme:Icons.Ellipsis}" Width="14" Height="14" Foreground="{StaticResource InfoTextBrush}" IsVisible="{Binding IsPending}" />
                            <TextBlock Classes="rowText" Classes.dangerText="{Binding IsMissing}" Classes.infoText="{Binding IsPending}" Text="{Binding Text}" VerticalAlignment="Center"
                                       AutomationProperties.Name="{Binding Spoken}" />
                          </StackPanel>
                          <Button Classes="link" FontSize="13" Content="{Binding Text}" Command="{Binding Command}" AutomationProperties.Name="{Binding Spoken}"
                                  IsVisible="{Binding Command, Converter={x:Static ObjectConverters.IsNotNull}}" ui:ButtonAssist.Icon="{x:Static theme:Icons.FolderOpen}" />
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </WrapPanel>
                <!-- In a table, a click on the reasons picks the cell they are about. -->
                <TextBlock x:Name="BlockedText" Classes="rowText dangerText" Text="{Binding BlockedText}" IsVisible="{Binding IsBlockedHere}" />
                <Button x:Name="BlockedCell" Classes="inlineLink" HorizontalAlignment="Left" Command="{Binding SelectBlockedCommand}" IsVisible="{Binding IsBlockedInTable}">
                  <TextBlock Classes="rowText dangerText" Text="{Binding BlockedText}" />
                </Button>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasOutput}">
                  <TextBlock Classes="caption" Text="{Binding OutputText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding OutputFolder}"
                             VerticalAlignment="Center" />
                  <Button x:Name="ChangeOutput" Grid.Column="1" Classes="link" FontSize="12" Content="{x:Static loc:Strings.Creator_ChangeOutput}"
                          Command="{Binding ChangeOutputCommand}" AutomationProperties.Name="{x:Static loc:Strings.Creator_OutputTitle}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Grid>

            <!-- The build under way: where the run stands, each of its packages with its size or how far it got, and the way to stop it. -->
            <StackPanel x:Name="Building" Spacing="10" IsVisible="{Binding Build.IsBuilding}" theme:Motion.Enter="True">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Border Classes="iconChip accent" Width="40" Height="40">
                  <ui:Icon Classes="spin" Data="{x:Static theme:Icons.LoaderCircle}" Width="20" Height="20" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" FontSize="14" Text="{Binding Build.Heading}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Classes="caption" Text="{Binding OutputText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding OutputFolder}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="link" FontSize="12" IsEnabled="False" Opacity="0.5" Content="{x:Static loc:Strings.Creator_ChangeOutput}" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static loc:Strings.Creator_OutputTitle}" />
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Classes="caption" Text="{x:Static loc:Strings.Creator_Version}" VerticalAlignment="Center" />
                  <TextBox Width="96" IsEnabled="False" Text="{Binding Description.Version, Mode=OneWay}" AutomationProperties.Name="{x:Static loc:Strings.Creator_Version}" />
                </StackPanel>
                <Button Grid.Column="3" Classes="outline headerAction" VerticalAlignment="Center" Content="{x:Static loc:Strings.Creator_Stop}" Command="{Binding Build.CancelBuildCommand}" />
              </Grid>
              <ScrollViewer MaxHeight="136" Margin="0,0,-12,0" Padding="0,0,12,0" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding Build.HasRunRows}">
                <ItemsControl x:Name="RunRows" ItemsSource="{Binding Build.RunRows}" AutomationProperties.Name="{x:Static loc:Strings.Creator_BuildingTitle}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="creator:RunRow">
                      <StackPanel Spacing="3" Margin="0,2">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                          <Panel Width="14" Height="14" VerticalAlignment="Center">
                            <ui:Icon Data="{x:Static theme:Icons.Check}" Width="14" Height="14" Classes="successText" IsVisible="{Binding IsFinished}" />
                            <ui:Icon Classes="spin" Data="{x:Static theme:Icons.LoaderCircle}" Width="14" Height="14" Foreground="{StaticResource InfoTextBrush}" IsVisible="{Binding IsBuilding}" />
                            <ui:Icon Data="{x:Static theme:Icons.Hourglass}" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding IsWaiting}" />
                          </Panel>
                          <TextBlock Grid.Column="1" Classes="rowText" Foreground="{StaticResource TextEmphasisBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                     ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Details}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Classes="caption" MinWidth="58" TextAlignment="Right" Text="{Binding Amount}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="3" Margin="24,0,0,0" IsVisible="{Binding IsBuilding}">
                          <ProgressBar Classes="thin" Maximum="100" Value="{Binding $parent[UserControl].((creator:ProjectPageViewModel)DataContext).Build.Progress}"
                                       AutomationProperties.Name="{Binding Name}" />
                          <TextBlock Classes="caption" Text="{Binding $parent[UserControl].((creator:ProjectPageViewModel)DataContext).Build.Stage}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                     ToolTip.Tip="{Binding $parent[UserControl].((creator:ProjectPageViewModel)DataContext).Build.FileLine}" />
                          <TextBlock Classes="pathLine" Text="{Binding $parent[UserControl].((creator:ProjectPageViewModel)DataContext).Build.FileLine}"
                                     IsVisible="{Binding $parent[UserControl].((creator:ProjectPageViewModel)DataContext).Build.ShowsFile}" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- Before the run knows its packages: the check, or the versions being told apart. -->
              <StackPanel Spacing="4" IsVisible="{Binding !Build.HasRunRows}">
                <ProgressBar Classes="thin" Maximum="100" Value="{Binding Build.Progress}" AutomationProperties.Name="{x:Static loc:Strings.Creator_BuildingTitle}" />
                <TextBlock Classes="caption" Text="{Binding Build.Stage}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
            </StackPanel>
          </Panel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- The chosen cell beside the table, or over it, closed by a click beside it or Escape, in a narrow window. -->
    <Border x:Name="Aside" Grid.Column="1" Classes="cellPanel" Classes.away="{Binding !IsPanelOpen}" theme:Motion.Shown="{Binding IsPanelOpen}"
            AutomationProperties.Name="{x:Static loc:Strings.Creator_PanelName}">
      <ScrollViewer>
        <StackPanel Spacing="12" Margin="20">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="caption" Text="{Binding PanelName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="ClosePanel" Grid.Column="1" Classes="icon" ToolTip.Tip="{x:Static loc:Strings.Creator_ClosePanel}"
                    AutomationProperties.Name="{x:Static loc:Strings.Creator_ClosePanel}" Command="{Binding ClosePanelCommand}">
              <ui:Icon Data="{x:Static theme:Icons.X}" Width="16" Height="16" />
            </Button>
          </Grid>
          <creator:CellPanel DataContext="{Binding Cell}" IsEnabled="{Binding !$parent[UserControl].((creator:ProjectPageViewModel)DataContext).Build.IsBuilding}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
