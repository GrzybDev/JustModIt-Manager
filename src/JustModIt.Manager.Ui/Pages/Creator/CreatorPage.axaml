<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.CreatorPage"
             x:DataType="creator:CreatorPageViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding ImportProjectCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <StyleInclude Source="avares://JustModIt.Manager.Ui/Pages/Creator/CreatorStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer Classes="page">
    <StackPanel x:Name="PageContent" Classes="page" Spacing="18" MaxWidth="{StaticResource PageMaxWidth}">
      <ui:PageHeader x:Name="Header" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="ImportButton" Classes="outline" Content="{x:Static loc:Strings.Creator_Import}" ui:ButtonAssist.Icon="{x:Static theme:Icons.FolderOpen}"
                  Command="{Binding ImportProjectCommand}" />
          <Button x:Name="ImportIconButton" Classes="icon large" IsVisible="False" ToolTip.Tip="{x:Static loc:Strings.Creator_Import}"
                  Command="{Binding ImportProjectCommand}">
            <ui:Icon Data="{x:Static theme:Icons.FolderOpen}" Foreground="{StaticResource TextEmphasisBrush}" />
          </Button>
          <Button Classes="primary" Height="40" Padding="18,0" FontSize="14" Content="{x:Static loc:Strings.Creator_New}" ui:ButtonAssist.Icon="{x:Static theme:Icons.Plus}"
                  Command="{Binding NewProjectCommand}" />
        </StackPanel>
      </ui:PageHeader>

      <ui:Callout Classes="danger" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.CircleX}"
                  Title="{Binding ProblemTitle}" Message="{Binding ProblemText}" IsVisible="{Binding HasProblem}"
                  theme:Motion.Enter="True">
        <Button Classes="quiet small" Content="{x:Static loc:Strings.Creator_DismissProblem}" HorizontalAlignment="Left"
                Margin="-12,0,0,0" Command="{Binding ClearProblemCommand}" />
      </ui:Callout>

      <ItemsControl ItemsSource="{Binding Notices}" IsVisible="{Binding !!Notices.Count}" ItemsPanel="{StaticResource StackItems12}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="creator:ImportNotice">
            <ui:Callout Classes.warning="{Binding IsWarning}" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{Binding Icon}"
                        Message="{Binding Text}" theme:Motion.Enter="True">
              <StackPanel Spacing="6">
                <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding IsWarning}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="monoPath" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="quiet small" Content="{x:Static loc:Strings.Creator_DismissProblem}" HorizontalAlignment="Left" Margin="-12,0,0,0"
                        Command="{Binding $parent[UserControl].((creator:CreatorPageViewModel)DataContext).DismissNoticeCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </ui:Callout>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ui:Callout x:Name="UnreadableCallout" Classes="warning" MaxWidth="Infinity" HorizontalAlignment="Stretch"
                  Icon="{x:Static theme:Icons.TriangleAlert}" Message="{Binding UnreadableText}" IsVisible="{Binding HasUnreadable}"
                  theme:Motion.Enter="True">
        <ItemsControl ItemsSource="{Binding Unreadable}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="creator:UnreadableProject">
              <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Classes="monoPath" Text="{Binding Shown}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
                  <Button Grid.Column="1" Classes="quiet small" Content="{x:Static loc:Strings.Creator_Reveal}" ui:ButtonAssist.Icon="{x:Static theme:Icons.Folder}"
                          Command="{Binding $parent[UserControl].((creator:CreatorPageViewModel)DataContext).RevealCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ui:Callout>

      <!-- While the first listing runs, cards stand in; the page never claims there are no projects. -->
      <ItemsControl ItemsSource="{Binding Skeletons}" IsVisible="{Binding IsListing}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <ui:PixelUniformGrid Columns="{Binding $parent[UserControl].((creator:CreatorPageViewModel)DataContext).Columns}" ColumnSpacing="14" RowSpacing="14" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:Int32">
            <Border Classes="card" Padding="14" BoxShadow="{StaticResource ElevNone}">
              <StackPanel Spacing="10">
                <ui:Skeleton Height="110" CornerRadius="8" />
                <ui:Skeleton Height="14" Width="120" HorizontalAlignment="Left" />
                <ui:Skeleton Height="12" Width="176" HorizontalAlignment="Left" />
                <ui:Skeleton Height="18" Width="96" HorizontalAlignment="Left" CornerRadius="999" />
                <ui:Skeleton Height="12" Width="136" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The grid lies out in rows, so the list virtualises; cards of a row enter one after another. -->
      <ItemsControl x:Name="CardList" ItemsSource="{Binding Rows}" IsVisible="{Binding !IsListing}" theme:Motion.Stagger="True"
                    ItemsPanel="{StaticResource VirtualRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ui:CardRow">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,14" theme:Motion.Stagger="True">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ui:PixelUniformGrid x:DataType="ui:CardRow" Columns="{Binding Columns}" ColumnSpacing="14" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate x:DataType="creator:ProjectCard">
                  <Panel Classes="projectCard">
                    <Button Classes="gameCard" AutomationProperties.Name="{Binding AccessibleName}"
                            Command="{Binding $parent[UserControl].((creator:CreatorPageViewModel)DataContext).OpenCardCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Spacing="10" Margin="14" ClipToBounds="True">
                        <Border Height="110" CornerRadius="8" ClipToBounds="True">
                          <Panel Background="{StaticResource SurfaceSunkenBrush}">
                            <Panel Classes="coverPlaceholder" IsVisible="{Binding !HasCover}">
                              <ui:Icon Data="{x:Static theme:Icons.Gamepad}" Width="26" Height="26" StrokeThickness="1.5"
                                       Foreground="#B3C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <ui:RemoteImage Classes="cover" Source="{Binding Cover}" />
                          </Panel>
                        </Border>
                        <TextBlock Classes="cardName" Text="{Binding Name}" />
                        <TextBlock Classes="rowText" FontSize="12" LineHeight="17" Text="{Binding Details}" />
                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                          <ItemsControl ItemsSource="{Binding Stores}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="6" LineSpacing="6" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="creator:StoreChip">
                                <Border Classes="chip">
                                  <StackPanel Orientation="Horizontal" Spacing="5">
                                    <ui:StoreIcon Store="{Binding Store}" Width="12" Height="12" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border Classes="chip" IsVisible="{Binding HasParts}">
                            <TextBlock Text="{Binding PartsText}" />
                          </Border>
                        </WrapPanel>
                        <ui:StatusLine FontSize="12" LineHeight="17" Icon="{Binding Line.Icon, FallbackValue={x:Null}}" Tone="{Binding Line.Tone, FallbackValue={x:Static ui:Tone.Neutral}}"
                                       Label="{Binding Line.Label, FallbackValue={x:Null}}" IsBusy="{Binding Line.IsBusy, FallbackValue=False}"
                                       ToolTip.Tip="{Binding FolderTip}" IsVisible="{Binding HasLine}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="icon cardMore" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,23,0" ToolTip.Tip="{Binding MoreName}"
                            Command="{Binding $parent[UserControl].((creator:CreatorPageViewModel)DataContext).CardMenuCommand}"
                            CommandParameter="{Binding}">
                      <ui:Icon Data="{x:Static theme:Icons.Ellipsis}" Width="16" Height="16" Foreground="{StaticResource TextStrongBrush}" />
                    </Button>
                  </Panel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
