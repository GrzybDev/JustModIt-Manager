<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.NewProjectDialog"
             x:DataType="creator:NewProjectDialogViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://JustModIt.Manager.Ui/Pages/Creator/CreatorStyles.axaml" />
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- What a game's row shows whether it can be chosen or not: its cover, its name, its store and, for a game that
         cannot be chosen, why. -->
    <DataTemplate x:Key="GameFace" x:DataType="creator:GameOption">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Classes="cover" VerticalAlignment="Center">
          <Panel>
            <ui:Icon Data="{x:Static theme:Icons.Gamepad}" Width="18" Height="18" Foreground="{StaticResource TextMutedBrush}" />
            <ui:RemoteImage Source="{Binding Cover}" IsVisible="{Binding HasCover}" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="15" LineHeight="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsBlockedByInstall}">
            <ui:StoreIcon Store="{Binding Store}" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Classes="pathLine" FontSize="12" Text="{Binding StoreName}" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding IsSelected}">
            <ui:Icon Data="{x:Static theme:Icons.Folder}" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="1" Classes="pathLine" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Text="{Binding Folder}"
                       ToolTip.Tip="{Binding Folder}" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding IsBlockedByInstall}">
            <ui:Icon Data="{x:Static theme:Icons.TriangleAlert}" Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top"
                     Foreground="{StaticResource WarningTextBrush}" />
            <TextBlock Grid.Column="1" Classes="rowText" LineHeight="18" Foreground="{StaticResource WarningTextBrush}"
                       Text="{Binding BlockText}" />
          </Grid>
          <WrapPanel IsVisible="{Binding IsBlockedByInstall}">
            <TextBlock Classes="rowText" LineHeight="18" Foreground="{StaticResource TextBodyBrush}"
                       Text="{x:Static loc:Strings.Creator_UninstallFirst}" Margin="0,0,4,0" />
            <Button Classes="link" FontSize="13" Content="{x:Static loc:Strings.Shell_Library}"
                    Command="{Binding $parent[UserControl].((creator:NewProjectDialogViewModel)DataContext).OpenGameCommand}"
                    CommandParameter="{Binding}" />
          </WrapPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding IsNotReady}">
            <ui:Icon Data="{x:Static theme:Icons.Clock}" Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top"
                     Foreground="{StaticResource NeutralTextBrush}" />
            <TextBlock Grid.Column="1" Classes="rowText" LineHeight="18" Foreground="{StaticResource NeutralTextBrush}"
                       Text="{Binding BlockText}" />
          </Grid>
        </StackPanel>
        <Border Grid.Column="2" Classes="chosenMark" VerticalAlignment="Center">
          <ui:Icon Data="{x:Static theme:Icons.Check}" Width="16" Height="16" StrokeThickness="2.5" />
        </Border>
      </Grid>
    </DataTemplate>

    <!-- A game that can be chosen is a radio tile; one that cannot is a plain row the keyboard passes by. -->
    <DataTemplate x:Key="GameCell" x:DataType="creator:GameOption">
      <Panel>
        <RadioButton Classes="gameChoice" Theme="{StaticResource ChoiceTile}" GroupName="creatorGame" IsVisible="{Binding IsSelectable}"
                     IsChecked="{Binding IsSelected, Mode=OneWay}" AutomationProperties.Name="{Binding Name}"
                     Command="{Binding $parent[UserControl].((creator:NewProjectDialogViewModel)DataContext).PickCommand}"
                     CommandParameter="{Binding}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameFace}" />
        </RadioButton>
        <Border Classes="gameBlocked" Classes.installed="{Binding IsBlockedByInstall}" IsVisible="{Binding !IsSelectable}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameFace}" />
        </Border>
      </Panel>
    </DataTemplate>

    <DataTemplate x:Key="MissingGame" x:DataType="creator:NewProjectDialogViewModel">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ui:Icon Data="{x:Static theme:Icons.Info}" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock Classes="meta" Text="{x:Static loc:Strings.Creator_MissingGame}" VerticalAlignment="Center" />
        <Button Classes="link" FontSize="13" Content="{x:Static loc:Strings.Creator_MissingGameLink}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.ArrowRight}" Command="{Binding ShowUndetectedCommand}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Border Classes="dialog" Width="780" Padding="28,26" AutomationProperties.Name="{x:Static loc:Strings.Creator_NewTitle}">
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16">
      <StackPanel Spacing="4">
        <TextBlock Classes="h2" Text="{x:Static loc:Strings.Creator_NewTitle}" />
        <TextBlock Classes="pathLine" FontSize="12" Text="{Binding Folder}" ToolTip.Tip="{Binding Folder}" IsVisible="{Binding HasFolder}" />
      </StackPanel>

      <!-- Only the choice scrolls, so the way on and what it needs stay in sight at the smallest window. Its bar runs in the
           dialog's padding rather than over the tiles. -->
      <ScrollViewer Grid.Row="1" Margin="0,0,-16,0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,16,0">
          <StackPanel Spacing="16" IsVisible="{Binding ShowsSearch}">
            <StackPanel Spacing="2">
              <TextBlock Classes="rowTitle" Text="{x:Static loc:Strings.Creator_GameTitle}" />
              <TextBlock Classes="rowText" Text="{x:Static loc:Strings.Creator_GameLead}" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
              <TextBox x:Name="Search" Classes="search" Width="290" Text="{Binding Query}" PlaceholderText="{x:Static loc:Strings.Creator_SearchGames}"
                       AutomationProperties.Name="{x:Static loc:Strings.Creator_SearchGames}" />
              <TextBlock Grid.Column="2" Classes="meta" Text="{Binding Count}" VerticalAlignment="Center" />
              <Button Grid.Column="3" Classes="quiet headerAction" Content="{x:Static loc:Strings.Creator_CheckNow}"
                      ui:ButtonAssist.Icon="{x:Static theme:Icons.RefreshCw}" Command="{Binding CheckNowCommand}" IsEnabled="{Binding !IsChecking}" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding IsLoading}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <ui:Skeleton Height="72" CornerRadius="12" />
              <ui:Skeleton Grid.Column="1" Height="72" CornerRadius="12" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <ui:Skeleton Height="72" CornerRadius="12" />
              <ui:Skeleton Grid.Column="1" Height="72" CornerRadius="12" />
            </Grid>
          </StackPanel>

          <ItemsControl x:Name="GameRows" ItemsSource="{Binding Rows}" IsVisible="{Binding IsListed}" theme:Motion.Stagger="True"
                        AutomationProperties.Name="{x:Static loc:Strings.Creator_GameTitle}" ItemsPanel="{StaticResource VirtualItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="creator:GameOptionRow">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,12">
                  <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource GameCell}" />
                  <ContentControl Grid.Column="1" Content="{Binding Right}" ContentTemplate="{StaticResource GameCell}"
                                  IsVisible="{Binding Right, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ui:EmptyState Classes="neutral compact" Padding="24,8,24,8" Icon="{x:Static theme:Icons.SearchX}"
                         Title="{x:Static loc:Strings.Creator_NoGames}" IsVisible="{Binding ShowsNoResults}" />

          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MissingGame}" IsVisible="{Binding IsListed}" />

          <Border Classes="soft" IsVisible="{Binding HasNoGames}" theme:Motion.Enter="True">
            <ui:EmptyState Classes="neutral compact" Padding="16,26" Icon="{x:Static theme:Icons.Gamepad}" Title="{x:Static loc:Strings.Creator_NoDetected}">
              <StackPanel Spacing="14">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MissingGame}" />
                <Button Classes="outline small" HorizontalAlignment="Center" Content="{x:Static loc:Strings.Creator_CheckNow}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.RefreshCw}" Command="{Binding CheckNowCommand}" IsEnabled="{Binding !IsChecking}" />
              </StackPanel>
            </ui:EmptyState>
          </Border>

          <Border CornerRadius="12" BorderThickness="1" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerEdgeBrush}"
                  IsVisible="{Binding HasFailed}" theme:Motion.Enter="True">
            <ui:EmptyState Classes="danger compact" Padding="16,26" Icon="{x:Static theme:Icons.CircleX}" Title="{x:Static loc:Strings.Creator_GamesFailed}">
              <Button Classes="outline small" Content="{x:Static loc:Strings.Library_Retry}" ui:ButtonAssist.Icon="{x:Static theme:Icons.RefreshCw}"
                      Command="{Binding ReadCommand}" />
            </ui:EmptyState>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ui:Callout Grid.Row="2" Classes="note" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.Info}"
                  Title="{x:Static loc:Strings.Creator_CleanGameTitle}" Message="{x:Static loc:Strings.Creator_CleanGame}" />

      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Classes="caption" FontSize="12" VerticalAlignment="Center" Text="{x:Static loc:Strings.Creator_NewHint}" IsVisible="{Binding HasFolder}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button Classes="outline" Content="{x:Static loc:Strings.Dialog_Cancel}" Command="{Binding CancelCommand}" />
          <Button x:Name="CreateButton" Classes="primary compact" Content="{x:Static loc:Strings.Creator_Create}" Command="{Binding CreateCommand}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
