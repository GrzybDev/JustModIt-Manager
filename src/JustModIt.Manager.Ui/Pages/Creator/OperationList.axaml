<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.OperationList"
             x:DataType="creator:ReviewViewModel">
  <Border Classes="creatorCard" ClipToBounds="True">
    <StackPanel>
      <WrapPanel Margin="20,12,16,12" MinHeight="36">
        <TextBlock Classes="h4" Text="{x:Static loc:Strings.Creator_OperationsTitle}" Margin="0,0,12,0" VerticalAlignment="Center" />
        <TextBlock Classes="meta" Text="{Binding Counts}" VerticalAlignment="Center" />
      </WrapPanel>
      <Border Classes="divider" />
      <ItemsControl x:Name="OperationRows" Classes="rows" ItemsSource="{Binding Operations}" ItemsPanel="{StaticResource VirtualItems}">
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="creator:OperationGroup">
            <Grid ColumnDefinitions="28,136,*,84,76" ColumnSpacing="14" Margin="20,14,16,12">
              <Button Classes="icon groupToggle" Classes.expanded="{Binding IsExpanded}" ToolTip.Tip="{x:Static loc:Strings.Creator_ToggleGroup}"
                      Command="{Binding $parent[UserControl].((creator:ReviewViewModel)DataContext).ToggleGroupCommand}"
                      CommandParameter="{Binding}" VerticalAlignment="Top" Width="28" Height="28">
                <ui:Icon Data="{x:Static theme:Icons.ChevronDown}" Width="16" Height="16" />
              </Button>
              <Border Grid.Column="1" Classes="kind" Margin="0,2,0,0">
                <StackPanel>
                  <ui:Icon Data="{x:Static theme:Icons.Copy}" />
                  <TextBlock Text="{x:Static loc:Strings.Creator_KindCopy}" />
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="2" Spacing="2">
                <WrapPanel>
                  <TextBlock FontSize="14" LineHeight="22" FontWeight="SemiBold" Text="{x:Static loc:Strings.Creator_NewFilesIn}" Margin="0,0,4,0" />
                  <TextBlock FontSize="14" LineHeight="22" FontWeight="SemiBold" Foreground="{StaticResource TextEmphasisBrush}"
                             Text="{Binding Folder}" Margin="0,0,6,0" />
                  <TextBlock FontSize="14" LineHeight="22" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Count}" Margin="0,0,8,0" />
                  <TextBlock FontSize="13" LineHeight="22" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Range}"
                             IsVisible="{Binding !IsExpanded}" />
                </WrapPanel>
                <TextBlock Classes="rowText" LineHeight="20" Text="{x:Static loc:Strings.Creator_NewFilesReason}" />
              </StackPanel>
              <TextBlock Grid.Column="3" Classes="meta" Foreground="{StaticResource TextBodyBrush}" Text="{Binding Size}"
                         HorizontalAlignment="Right" Margin="0,1,0,0" />
            </Grid>
          </DataTemplate>
          <DataTemplate DataType="creator:OperationRow">
            <Grid ColumnDefinitions="28,136,*,84,76" ColumnSpacing="14" Margin="20,14,16,14">
              <Border Classes="number" VerticalAlignment="Top">
                <TextBlock Text="{Binding Number}" />
              </Border>
              <Border Grid.Column="1" Classes="kind" Margin="0,2,0,0" IsVisible="{Binding ShowsKind}"
                      Classes.danger="{Binding KindTone, Converter={x:Static creator:ReviewRows.IsDanger}}"
                      Classes.neutral="{Binding IsExcluded}">
                <StackPanel>
                  <ui:Icon Data="{Binding KindIcon}" />
                  <TextBlock Text="{Binding KindText}" />
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="2" Spacing="2">
                <WrapPanel>
                  <StackPanel Orientation="Horizontal" IsVisible="{Binding IsRename}">
                    <TextBlock FontSize="14" LineHeight="22" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding FromFolder}" />
                    <TextBlock FontSize="14" LineHeight="22" FontWeight="SemiBold" Text="{Binding FromName}" />
                    <ui:Icon Data="{x:Static theme:Icons.ArrowRight}" Width="14" Height="14" Margin="6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                  </StackPanel>
                  <TextBlock FontSize="14" LineHeight="22" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Folder}" />
                  <TextBlock FontSize="14" LineHeight="22" FontWeight="SemiBold" Text="{Binding Name}"
                             Foreground="{StaticResource TextBrush}" Classes.secondaryText="{Binding IsExcluded}" />
                </WrapPanel>
                <Border Classes="kind danger" IsVisible="{Binding BreaksRules}" Margin="0,4,0,2">
                  <StackPanel>
                    <ui:Icon Data="{x:Static theme:Icons.CircleX}" />
                    <TextBlock Text="{x:Static loc:Strings.Creator_BreaksRules}" />
                  </StackPanel>
                </Border>
                <WrapPanel>
                  <TextBlock Classes="rowText" LineHeight="20" Text="{Binding Reason}" Margin="0,0,10,0"
                             IsVisible="{Binding Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <Button Classes="link" FontSize="13" Content="{x:Static loc:Strings.Creator_Restore}" IsVisible="{Binding IsExcluded}"
                          ui:ButtonAssist.Icon="{x:Static theme:Icons.Undo}"
                          Command="{Binding $parent[UserControl].((creator:ReviewViewModel)DataContext).RestoreCommand}"
                          CommandParameter="{Binding}" />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}" IsVisible="{Binding HasFindings}" />
                <WrapPanel IsVisible="{Binding IsDecision}" Margin="0,10,0,0">
                  <TextBlock Classes="rowText" Text="{x:Static loc:Strings.Creator_MissingQuestion}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <ItemsControl ItemsSource="{Binding Choices}" ItemsPanel="{StaticResource RowItems8}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="creator:ChoiceOption">
                        <RadioButton Theme="{StaticResource ChoicePill}" Content="{Binding Title}" IsChecked="{Binding IsChecked, Mode=OneWay}"
                                     GroupName="{Binding $parent[ContentPresenter].((creator:OperationRow)DataContext).Key}"
                                     Command="{Binding $parent[UserControl].((creator:ReviewViewModel)DataContext).ChooseCommand}"
                                     CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </WrapPanel>
                <Border Classes="editPanel" IsVisible="{Binding IsEditing}" Margin="0,12,0,0" theme:Motion.Enter="True">
                  <StackPanel Spacing="12">
                    <WrapPanel>
                      <TextBlock Classes="rowText" Text="{x:Static loc:Strings.Creator_EditQuestion}" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <ItemsControl ItemsSource="{Binding Choices}" ItemsPanel="{StaticResource WrapItems8}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="creator:ChoiceOption">
                            <RadioButton Theme="{StaticResource ChoicePill}" IsChecked="{Binding IsChecked, Mode=OneWay}"
                                         AutomationProperties.Name="{Binding Title}"
                                         GroupName="{Binding $parent[ContentPresenter].((creator:OperationRow)DataContext).Key}"
                                         Command="{Binding $parent[UserControl].((creator:ReviewViewModel)DataContext).ChooseCommand}"
                                         CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static loc:Strings.Creator_Default}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" IsVisible="{Binding IsDefault}" />
                              </StackPanel>
                            </RadioButton>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </WrapPanel>
                    <TextBlock Classes="rowText" LineHeight="20" Foreground="{StaticResource TextBodyBrush}" Text="{Binding EditText}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasEditNote}">
                      <ui:Icon Data="{x:Static theme:Icons.Info}" Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1" Classes="rowText" LineHeight="20" Text="{Binding EditNote}" />
                    </Grid>
                    <Button Classes="outline headerAction" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_Done}"
                            ui:ButtonAssist.Icon="{x:Static theme:Icons.Check}"
                            Command="{Binding ToggleEditCommand}" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="3" Classes="meta" Foreground="{StaticResource TextBodyBrush}" Text="{Binding Size}"
                         HorizontalAlignment="Right" Margin="0,1,0,0" />
              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0">
                <Button Classes="icon" Classes.expanded="{Binding IsEditing}" ToolTip.Tip="{x:Static loc:Strings.Creator_EditOperation}"
                        IsVisible="{Binding CanEdit}" Command="{Binding ToggleEditCommand}">
                  <ui:Icon Data="{x:Static theme:Icons.Pencil}" Width="16" Height="16" />
                </Button>
                <Button Classes="icon" ToolTip.Tip="{x:Static loc:Strings.Creator_Exclude}" IsVisible="{Binding CanExclude}"
                        Command="{Binding $parent[UserControl].((creator:ReviewViewModel)DataContext).ExcludeCommand}"
                        CommandParameter="{Binding}">
                  <ui:Icon Data="{x:Static theme:Icons.CircleMinus}" Width="16" Height="16" />
                </Button>
                <Button Classes="icon" ToolTip.Tip="{x:Static loc:Strings.Creator_RemoveOperation}" IsVisible="{Binding CanRemove}"
                        Command="{Binding $parent[UserControl].((creator:ReviewViewModel)DataContext).RemoveCommand}"
                        CommandParameter="{Binding}">
                  <ui:Icon Data="{x:Static theme:Icons.X}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
      <Border Classes="divider" />
      <Grid ColumnDefinitions="*,Auto" Margin="8,8,12,8">
        <Button Classes="quiet" HorizontalAlignment="Left" Content="{Binding IdenticalCount}" IsVisible="{Binding HasIdentical}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.Check}" Classes.expanded="{Binding ShowsIdentical}"
                Command="{Binding ToggleIdenticalCommand}" />
        <Button Grid.Column="1" x:Name="AddOperationButton" Classes="quiet" Content="{x:Static loc:Strings.Creator_AddOperation}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.Plus}" Classes.expanded="{Binding IsAdding}" Command="{Binding ToggleAddingCommand}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding IdenticalFiles}" IsVisible="{Binding ShowsIdentical}" Margin="44,0,20,12"
                    ItemsPanel="{StaticResource VirtualItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="pathLine" Text="{Binding}" Margin="0,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="editPanel" Margin="20,0,20,20" IsVisible="{Binding IsAdding}" theme:Motion.Enter="True">
        <StackPanel Spacing="12">
          <TextBlock Classes="rowTitle" Text="{x:Static loc:Strings.Creator_AddOperation}" />
          <ui:PixelUniformGrid Columns="2" ColumnSpacing="12" IsVisible="{Binding !IsNamingRename}">
            <Button Classes="addTile" AutomationProperties.Name="{x:Static loc:Strings.Creator_AddDelete}" Command="{Binding AddDeleteCommand}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Classes="folderChip" Width="36" Height="36">
                  <ui:Icon Data="{x:Static theme:Icons.FileX}" Width="18" Height="18" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" Text="{x:Static loc:Strings.Creator_AddDelete}" />
                  <TextBlock Classes="rowText" Text="{x:Static loc:Strings.Creator_AddDeleteText}" />
                </StackPanel>
                <ui:Icon Grid.Column="2" Data="{x:Static theme:Icons.ChevronRight}" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}" />
              </Grid>
            </Button>
            <Button Classes="addTile" AutomationProperties.Name="{x:Static loc:Strings.Creator_AddRename}" Command="{Binding AddRenameCommand}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Classes="folderChip" Width="36" Height="36">
                  <ui:Icon Data="{x:Static theme:Icons.FilePen}" Width="18" Height="18" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" Text="{x:Static loc:Strings.Creator_AddRename}" />
                  <TextBlock Classes="rowText" Text="{x:Static loc:Strings.Creator_AddRenameText}" />
                </StackPanel>
                <ui:Icon Grid.Column="2" Data="{x:Static theme:Icons.ChevronRight}" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}" />
              </Grid>
            </Button>
          </ui:PixelUniformGrid>
          <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding IsNamingRename}">
            <TextBlock Classes="pathLine" Foreground="{StaticResource TextBrush}" Text="{Binding RenameFrom}" VerticalAlignment="Center" />
            <ui:Icon Grid.Column="1" Data="{x:Static theme:Icons.ArrowRight}" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Column="2" Text="{Binding RenameTo}" FontSize="14" AutomationProperties.Name="{x:Static loc:Strings.Creator_StepNewName}" />
            <Button Grid.Column="3" Classes="outline headerAction" Content="{x:Static loc:Strings.Creator_AddConfirm}"
                    ui:ButtonAssist.Icon="{x:Static theme:Icons.Plus}" Command="{Binding ConfirmRenameCommand}" />
          </Grid>
          <TextBlock Classes="rowText" LineHeight="20" Text="{Binding AddNote}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
