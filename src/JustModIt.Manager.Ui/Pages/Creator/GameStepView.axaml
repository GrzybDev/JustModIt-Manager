<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.GameStepView"
             x:DataType="creator:GameStepViewModel">
  <UserControl.Resources>
    <!-- What a game's row shows whether it can be chosen or not: its cover, its name, its store and, for a game that
         cannot be chosen, why. -->
    <DataTemplate x:Key="GameFace" x:DataType="creator:GameOption">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Classes="cover" VerticalAlignment="Center">
          <Panel>
            <ui:Icon Data="{x:Static theme:Icons.Gamepad}" Width="18" Height="18" Foreground="{StaticResource TextMutedBrush}" />
            <ui:RemoteImage Source="{Binding Cover}" IsVisible="{Binding HasCover}" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="15" LineHeight="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsBlockedByInstall}">
            <ui:StoreIcon Store="{Binding Store}" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Classes="pathLine" Text="{Binding StoreName}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSelected}">
            <ui:Icon Data="{x:Static theme:Icons.Folder}" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Classes="pathLine" Foreground="{StaticResource TextBodyBrush}" Text="{Binding Folder}"
                       ToolTip.Tip="{Binding Folder}" MaxWidth="360" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding IsBlockedByInstall}">
            <ui:Icon Data="{x:Static theme:Icons.TriangleAlert}" Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top"
                     Foreground="{StaticResource WarningTextBrush}" />
            <TextBlock Grid.Column="1" Classes="rowText" LineHeight="18" Foreground="{StaticResource WarningTextBrush}"
                       Text="{Binding BlockText}" />
          </Grid>
          <WrapPanel IsVisible="{Binding IsBlockedByInstall}">
            <TextBlock Classes="rowText" LineHeight="18" Foreground="{StaticResource TextBodyBrush}"
                       Text="{x:Static loc:Strings.Creator_UninstallFirst}" Margin="0,0,4,0" />
            <Button Classes="link" FontSize="13" Content="{x:Static loc:Strings.Shell_Library}"
                    Command="{Binding $parent[UserControl].((creator:GameStepViewModel)DataContext).OpenGameCommand}"
                    CommandParameter="{Binding}" />
          </WrapPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding IsNotReady}">
            <ui:Icon Data="{x:Static theme:Icons.Clock}" Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top"
                     Foreground="{StaticResource NeutralTextBrush}" />
            <TextBlock Grid.Column="1" Classes="rowText" LineHeight="18" Foreground="{StaticResource NeutralTextBrush}"
                       Text="{Binding BlockText}" />
          </Grid>
        </StackPanel>
        <Border Grid.Column="2" Classes="chosenMark" VerticalAlignment="Center">
          <ui:Icon Data="{x:Static theme:Icons.Check}" Width="16" Height="16" StrokeThickness="2.5" />
        </Border>
      </Grid>
    </DataTemplate>

    <!-- A game that can be chosen is a radio tile; one that cannot is a plain row the keyboard passes by. -->
    <DataTemplate x:Key="GameCell" x:DataType="creator:GameOption">
      <Panel>
        <RadioButton Classes="gameChoice" Theme="{StaticResource ChoiceTile}" GroupName="creatorGame" IsVisible="{Binding IsSelectable}"
                     IsChecked="{Binding IsSelected, Mode=OneWay}" AutomationProperties.Name="{Binding Name}"
                     Command="{Binding $parent[UserControl].((creator:GameStepViewModel)DataContext).PickCommand}"
                     CommandParameter="{Binding}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameFace}" />
        </RadioButton>
        <Border Classes="gameBlocked" Classes.installed="{Binding IsBlockedByInstall}" IsVisible="{Binding !IsSelectable}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameFace}" />
        </Border>
      </Panel>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="20">
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="{x:Static loc:Strings.Creator_GameTitle}" />
      <TextBlock Classes="lead" Text="{x:Static loc:Strings.Creator_GameLead}" />
    </StackPanel>

    <ui:Callout MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.Info}"
                Title="{x:Static loc:Strings.Creator_CleanGameTitle}" Message="{x:Static loc:Strings.Creator_CleanGame}" />

    <StackPanel Spacing="16">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <TextBox x:Name="Search" Classes="search" Width="320" Text="{Binding Query}" PlaceholderText="{x:Static loc:Strings.Creator_SearchGames}"
                 AutomationProperties.Name="{x:Static loc:Strings.Creator_SearchGames}" />
        <TextBlock Grid.Column="2" Classes="meta" Text="{Binding Count}" VerticalAlignment="Center" />
        <Button Grid.Column="3" Classes="quiet headerAction" Content="{x:Static loc:Strings.Creator_CheckNow}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.RefreshCw}" Command="{Binding CheckNowCommand}" IsEnabled="{Binding !IsChecking}" />
      </Grid>

      <StackPanel Spacing="12" IsVisible="{Binding !IsLoaded}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <ui:Skeleton Height="86" CornerRadius="12" />
          <ui:Skeleton Grid.Column="1" Height="86" CornerRadius="12" />
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <ui:Skeleton Height="86" CornerRadius="12" />
          <ui:Skeleton Grid.Column="1" Height="86" CornerRadius="12" />
        </Grid>
      </StackPanel>

      <ItemsControl x:Name="GameRows" ItemsSource="{Binding Rows}" IsVisible="{Binding ShowsGames}" theme:Motion.Stagger="True"
                    AutomationProperties.Name="{x:Static loc:Strings.Creator_GameTitle}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="creator:GameOptionRow">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,12">
              <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource GameCell}" />
              <ContentControl Grid.Column="1" Content="{Binding Right}" ContentTemplate="{StaticResource GameCell}"
                              IsVisible="{Binding Right, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ui:EmptyState Classes="neutral" Padding="24,24,24,20" Icon="{x:Static theme:Icons.SearchX}"
                     Title="{x:Static loc:Strings.Creator_NoGames}" IsVisible="{Binding ShowsNoResults}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <ui:Icon Data="{x:Static theme:Icons.Info}" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}" />
      <TextBlock Classes="meta" FontSize="14" Text="{x:Static loc:Strings.Creator_MissingGame}" VerticalAlignment="Center" />
      <Button Classes="link" FontSize="14" Content="{x:Static loc:Strings.Creator_MissingGameLink}"
              ui:ButtonAssist.Icon="{x:Static theme:Icons.ArrowRight}" Command="{Binding ShowUndetectedCommand}" />
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
      <Button x:Name="ContinueButton" Grid.Column="1" Classes="primary" Content="{x:Static loc:Strings.Creator_ToFiles}"
              ui:ButtonAssist.Icon="{x:Static theme:Icons.ArrowRight}" ui:ButtonAssist.IconAfter="True"
              Command="{Binding ContinueCommand}" />
    </Grid>
  </StackPanel>
</UserControl>
