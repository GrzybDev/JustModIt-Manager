<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
        xmlns:ui="using:JustModIt.Manager.Ui.Controls"
        xmlns:theme="using:JustModIt.Manager.Ui.Theme"
        xmlns:loc="using:JustModIt.Manager.Localization">
  <!-- The package creator (the Kreator boards): its projects' cards, a project's tabs over raised cards of radius 16, soft rows of radius
       12 for lists, and the bar pinned under the tabs that holds the build. -->

  <Styles.Resources>
    <!-- A file's path on a line of its own, in a list of paths. -->
    <DataTemplate x:Key="PathLineTemplate" x:DataType="x:String">
      <TextBlock Classes="pathLine" Text="{Binding}" Margin="0,2" />
    </DataTemplate>

    <!-- What a tile that adds something holds: its icon, its name, a text when it has one and the arrow on. -->
    <ControlTheme x:Key="AddTile" TargetType="ui:TileContent">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Classes="iconChip">
              <ui:Icon Data="{TemplateBinding Icon}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="rowTitle" Text="{TemplateBinding Title}" />
              <TextBlock Classes="rowText" Text="{TemplateBinding Message}"
                         IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ui:Icon Grid.Column="2" Data="{x:Static theme:Icons.ChevronRight}" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- A finding at an operation or a step, with a way to accept it where the rules allow, and once accepted the way back. -->
    <DataTemplate x:Key="FindingTemplate" x:DataType="creator:FindingLine">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
        <ui:Icon Data="{Binding Icon}" Width="14" Height="14" Margin="0,3,0,0" VerticalAlignment="Top"
                 Classes.dangerText="{Binding Tone, Converter={x:Static creator:ReviewRows.IsDanger}}"
                 Classes.warningText="{Binding Tone, Converter={x:Static creator:ReviewRows.IsWarning}}"
                 Classes.successText="{Binding Tone, Converter={x:Static creator:ReviewRows.IsSuccess}}" />
        <TextBlock Grid.Column="1" Classes="rowText" LineHeight="20" Text="{Binding Text}"
                   Classes.dangerText="{Binding Tone, Converter={x:Static creator:ReviewRows.IsDanger}}"
                   Classes.warningText="{Binding Tone, Converter={x:Static creator:ReviewRows.IsWarning}}" />
        <Button Grid.Column="2" Classes="outline small accept" Content="{x:Static loc:Strings.Creator_Accept}" IsVisible="{Binding CanAcknowledge}"
                Command="{Binding $parent[UserControl].((creator:ReviewViewModel)DataContext).AcceptCommand}"
                CommandParameter="{Binding AcknowledgementKey}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" IsVisible="{Binding IsAccepted}">
          <Border Classes="kind success" VerticalAlignment="Center">
            <StackPanel>
              <ui:Icon Data="{x:Static theme:Icons.Check}" />
              <TextBlock Text="{x:Static loc:Strings.Creator_Accepted}" />
            </StackPanel>
          </Border>
          <Button Classes="outline small undoAccept" Content="{x:Static loc:Strings.Creator_UndoAccept}"
                  Command="{Binding $parent[UserControl].((creator:ReviewViewModel)DataContext).UndoAcceptCommand}"
                  CommandParameter="{Binding AcknowledgementKey}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Styles.Resources>

  <!-- The head's actions are 36 px, a step smaller than the page's own. -->
  <Style Selector="Button.headerAction">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style Selector="Button.headerAction.quiet">
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- A project's card rises as one with the button over its cover, which a rise of the card alone would leave behind. -->
  <Style Selector="Panel.projectCard">
    <Setter Property="RenderTransform" Value="translateY(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Panel.projectCard:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-4px)" />
  </Style>
  <Style Selector=":is(Window).reducedMotion Panel.projectCard:pointerover">
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>
  <Style Selector="Panel.projectCard Button.gameCard:pointerover">
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>
  <!-- A card's state takes two lines at most; its tooltip holds what does not fit. -->
  <Style Selector="Panel.projectCard ui|StatusLine > TextBlock">
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Button.cardMore">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="Background" Value="#99030712" />
  </Style>

  <!-- A number in a ring: an operation's or a step's place, or a file's mark. -->
  <Style Selector="Border.number">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
    <Setter Property="Background" Value="{StaticResource FillSubtleBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextEmphasisBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.number TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A raised part of a tab, and a soft row inside or beside one. -->
  <Style Selector="Border.creatorCard">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BoxShadow" Value="{StaticResource ElevRest}" />
  </Style>
  <!-- The bar under a project's tabs, and the strip of the tabs. A part's card, and the button that adds an add-on, take the accent
       while a folder is dragged over them. -->
  <Style Selector="Border.buildBar">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="Border.tabs">
    <Setter Property="Background" Value="{StaticResource FillSubtleBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Border.cellCard.over">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.addPart.over /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.cellCard:not(.flat) WrapPanel#HeadActions">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.cellCard.flat WrapPanel#HeadActions">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <Style Selector="Border.cellCard.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- A cell of a project's table: its state over what its plan holds; the chosen one takes the accent's edge. -->
  <Style Selector="Button.cell">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="92" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.cell /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.cell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceFloatingBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Button.cell.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceFloatingBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- The chosen cell's panel beside the table, which slides in; over the table in a narrow window, with its own shadow. -->
  <Style Selector="Border.cellPanel">
    <Setter Property="Width" Value="380" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="RenderTransform" Value="translateX(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.cellPanel.away">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="translateX(24px)" />
  </Style>
  <Style Selector=":is(Window).reducedMotion Border.cellPanel.away">
    <Setter Property="RenderTransform" Value="translateX(0px)" />
  </Style>
  <Style Selector="creator|ProjectPage:not(.overlay) Button#ClosePanel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="creator|ProjectPage.overlay Border.cellPanel">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="ZIndex" Value="2" />
    <Setter Property="Background" Value="{StaticResource SurfaceFloatingBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource ElevFloating}" />
  </Style>
  <Style Selector="Border.soft">
    <Setter Property="Background" Value="#08FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="TextBlock.lead">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="820" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <StyleInclude Source="avares://JustModIt.Manager.Ui/Pages/Creator/CreatorRowStyles.axaml" />

  <!-- A choice of a game: a row with its cover that turns to the accent once chosen; a game that cannot be chosen keeps
       its full colour and says why in its own. -->
  <Style Selector="RadioButton.gameChoice">
    <Setter Property="Padding" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.soft.installed">
    <Setter Property="BorderBrush" Value="{StaticResource WarningEdgeBrush}" />
  </Style>
  <Style Selector="Border.chosenMark">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftStrongBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="RadioButton:checked Border.chosenMark">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- The formats' table: the package's own format stands out. -->
  <Style Selector="TextBlock.extension">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
  </Style>
  <Style Selector="TextBlock.extension.chosen">
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>

  <StyleInclude Source="avares://JustModIt.Manager.Ui/Pages/Creator/CreatorDropStyles.axaml" />

  <!-- A dialog's quieter parts: a note that explains rather than warns, and an empty state under its own title. -->
  <Style Selector="ui|Callout.note">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ui|Callout.note /template/ TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="17" />
  </Style>
  <Style Selector="ui|EmptyState.compact /template/ TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="21" />
  </Style>
  <Style Selector="ui|EmptyState.danger /template/ Border#Chip">
    <Setter Property="Background" Value="{StaticResource DangerChipBrush}" />
  </Style>
  <Style Selector="ui|EmptyState.danger /template/ ui|Icon#Glyph">
    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
  </Style>
</Styles>
