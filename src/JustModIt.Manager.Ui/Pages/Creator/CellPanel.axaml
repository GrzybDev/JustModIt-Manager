<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.CellPanel"
             x:DataType="creator:CellViewModel"
             ClipToBounds="False">
  <!-- A folder dropped on the card takes the place of the part's folder. -->
  <!-- In the panel beside a table the card's frame is the panel's. -->
  <Border x:Name="Cell" Classes="creatorCard cellCard" Classes.flat="{Binding Page.IsTable}" Padding="20,18" creator:FolderDrop.Command="{Binding DropCommand}"
          AutomationProperties.Name="{x:Static loc:Strings.Creator_PackageFilesTitle}">
    <StackPanel Spacing="14">
      <!-- An add-on the site names, added before it had a folder: the card is the place to drop one. -->
      <Border x:Name="FeatureDrop" Classes="dropZone strip" IsVisible="{Binding WaitsForFolder}">
        <Panel>
          <Rectangle Classes="dropFrame" />
          <StackPanel Spacing="6">
            <TextBlock Classes="rowTitle" Text="{Binding Key.Part}" />
            <WrapPanel>
              <TextBlock Classes="rowText" Foreground="{StaticResource TextBodyBrush}" Text="{Binding DropText}" Margin="0,0,4,0" />
              <Button Classes="link" FontSize="13" Content="{x:Static loc:Strings.Creator_PickFeature}" AutomationProperties.Name="{Binding PickName}"
                      Command="{Binding ChangeFolderCommand}" />
            </WrapPanel>
          </StackPanel>
        </Panel>
      </Border>

      <!-- The head, the one place to compare again; in the panel beside a table its actions stand under it. -->
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" IsVisible="{Binding !WaitsForFolder}">
        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="{Binding Page.PartLine}" IsVisible="{Binding !Page.IsTable}" />
          <WrapPanel ItemSpacing="12" LineSpacing="4">
            <TextBlock Classes="h4" Text="{x:Static loc:Strings.Creator_PackageFilesTitle}" VerticalAlignment="Center" />
            <ui:StatusLine x:Name="CellState" FontSize="13" LineHeight="20" VerticalAlignment="Center" Icon="{Binding Line.Icon}" Tone="{Binding Line.Tone}"
                           Label="{Binding Line.Label}" Detail="{Binding Line.Detail}" IsBusy="{Binding Line.IsBusy}" />
          </WrapPanel>
          <TextBlock Classes="pathLine" Text="{Binding Folder}" ToolTip.Tip="{Binding Folder}" />
          <TextBlock Classes="meta" Text="{Binding Page.Review.Counts}" IsVisible="{Binding IsCompared}" />
        </StackPanel>
        <WrapPanel x:Name="HeadActions" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Top">
          <Button x:Name="ChangeFolder" Classes="outline headerAction" Content="{x:Static loc:Strings.Creator_ChangeFolder}"
                  ui:ButtonAssist.Icon="{x:Static theme:Icons.FolderOpen}" Command="{Binding ChangeFolderCommand}" />
          <Button x:Name="CompareAgain" Classes="outline headerAction" Content="{x:Static loc:Strings.Creator_CompareAgain}"
                  ui:ButtonAssist.Icon="{x:Static theme:Icons.RefreshCw}" Command="{Binding CompareCommand}" IsEnabled="{Binding CanCompare}"
                  IsVisible="{Binding !IsComparing}" />
          <Button x:Name="CancelButton" Classes="outline headerAction" Content="{x:Static loc:Strings.Dialog_Cancel}"
                  Command="{Binding CancelCommand}" IsVisible="{Binding IsComparing}" />
        </WrapPanel>
      </Grid>

      <!-- What changed since the part's last build, by the operations it touches. -->
      <StackPanel x:Name="Changes" Spacing="4" theme:Motion.Enter="True" IsVisible="{Binding ShowsChanges}">
        <TextBlock Classes="rowText" Foreground="{StaticResource TextBodyBrush}" Text="{Binding ChangedText}" />
        <ItemsControl ItemsSource="{Binding Changes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="creator:OperationRow">
              <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="kind" VerticalAlignment="Center" Classes.danger="{Binding KindTone, Converter={x:Static creator:ReviewRows.IsDanger}}">
                    <StackPanel>
                      <ui:Icon Data="{Binding KindIcon}" />
                      <TextBlock Text="{Binding KindText}" />
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="1" Classes="pathLine" VerticalAlignment="Center" ToolTip.Tip="{Binding Key}">
                    <Run Text="{Binding Folder}" /><Run Text="{Binding Name}" Foreground="{StaticResource TextBrush}" />
                  </TextBlock>
                  <TextBlock Grid.Column="2" Classes="meta" VerticalAlignment="Center" Text="{Binding Size}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel x:Name="Comparing" Spacing="10" IsVisible="{Binding IsComparing}" theme:Motion.Enter="True">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock Classes="meta" Foreground="{StaticResource TextBodyBrush}" Text="{Binding Stage}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Classes="meta" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="{Binding Percent}" />
        </Grid>
        <ProgressBar Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"
                     AutomationProperties.Name="{Binding Line.Label}" />
        <TextBlock Classes="pathLine" Text="{Binding FileLine}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Icon Data="{x:Static theme:Icons.Info}" Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Classes="meta" Text="{x:Static loc:Strings.Creator_ReadOnlyNote}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- What stopped the comparison, or what keeps the version from being compared now. -->
      <ui:Callout x:Name="CellProblem" Classes.danger="{Binding Line.Tone, Converter={x:Static ui:ChoiceConverter.Instance}, ConverterParameter={x:Static ui:Tone.Danger}}"
                  Classes.warning="{Binding Line.Tone, Converter={x:Static ui:ChoiceConverter.Instance}, ConverterParameter={x:Static ui:Tone.Warning}}"
                  MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{Binding Line.Icon}" Title="{Binding NoticeTitle}" Message="{Binding NoticeText}"
                  IsVisible="{Binding HasNotice}" theme:Motion.Enter="True">
        <WrapPanel IsVisible="{Binding IsBlockedByInstall}">
          <TextBlock Classes="rowText" LineHeight="18" Foreground="{StaticResource TextBodyBrush}" Text="{x:Static loc:Strings.Creator_UninstallFirst}"
                     Margin="0,0,4,0" />
          <Button Classes="link" FontSize="13" Content="{x:Static loc:Strings.Shell_Library}" Command="{Binding OpenGameCommand}" />
        </WrapPanel>
      </ui:Callout>
      <ui:Callout MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.Info}"
                  Title="{x:Static loc:Strings.Creator_DroppedFilesTitle}" Message="{x:Static loc:Strings.Creator_DroppedFiles}"
                  IsVisible="{Binding DroppedFiles}" theme:Motion.Enter="True" />

      <StackPanel Spacing="8" IsVisible="{Binding HasNothingToPackage}">
        <ui:Callout Classes="warning" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.TriangleAlert}"
                    Title="{Binding NothingTitle}" Message="{Binding NothingText}" theme:Motion.Enter="True" />
        <Button Classes="quiet" HorizontalAlignment="Left" Margin="-12,0,0,0" Content="{Binding IdenticalCount}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.Check}" Classes.expanded="{Binding ShowsIdentical}"
                Command="{Binding ToggleIdenticalCommand}" IsVisible="{Binding HasIdentical}" />
        <ItemsControl ItemsSource="{Binding IdenticalFiles}" IsVisible="{Binding ShowsIdentical}" Margin="28,0,0,0" ItemTemplate="{StaticResource PathLineTemplate}" />
      </StackPanel>

      <!-- The compared part: the rules it meets, the problems of the whole package and the way to its operations. -->
      <Panel IsVisible="{Binding IsCompared}">
        <StackPanel Spacing="14" DataContext="{Binding Page.Review}" x:DataType="creator:ReviewViewModel">
          <creator:RulesList />
          <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="creator:FindingLine">
                <ui:Callout Classes="danger" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.CircleX}"
                            Message="{Binding Text}" Margin="0,0,0,8" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Panel>
      <!-- What the cell shares with the first version, and where its folders lie, which no finding would tell. -->
      <StackPanel x:Name="Folded" Spacing="4" IsVisible="{Binding ShowsFolded}">
        <TextBlock Classes="rowTitle" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Static loc:Strings.Creator_Folded}" />
        <TextBlock Classes="rowText" Text="{Binding Folded}" />
      </StackPanel>
      <WrapPanel ItemSpacing="18" LineSpacing="8">
        <Button x:Name="AllOperations" Classes="link" FontSize="13" Content="{Binding Page.AllOperationsText}" Command="{Binding Page.ShowOperationsCommand}"
                IsVisible="{Binding IsCompared}" />
        <Button x:Name="ToAdvanced" Classes="link" FontSize="13" Content="{x:Static loc:Strings.Creator_ToAdvancedButton}" ToolTip.Tip="{x:Static loc:Strings.Creator_AdvancedHint}"
                Command="{Binding Page.Review.ToAdvancedCommand}">
          <Button.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasReview" />
              <Binding Path="!Page.Review.IsAdvanced" />
            </MultiBinding>
          </Button.IsVisible>
        </Button>
        <!-- One version's card has no table to add a version or an add-on to. -->
        <Button x:Name="AddFeature" Classes="link" FontSize="13" Content="{x:Static loc:Strings.Creator_AddFeature}" Command="{Binding Page.AddPartCommand}"
                IsVisible="{Binding !Page.IsTable}" />
        <Button x:Name="AddVersion" Classes="link" FontSize="13" Content="{x:Static loc:Strings.Creator_AddGameVersion}" Command="{Binding Page.AddVersionCommand}"
                IsVisible="{Binding !Page.IsTable}" />
        <!-- A version that holds a test package keeps the only way to its undo, the packages' card on this page. An add-on's cell
             takes the add-on off the project instead. -->
        <Button x:Name="RemoveVersion" Classes="link" FontSize="13" Content="{Binding RemoveText}" Command="{Binding Page.RemoveVersionCommand}">
          <Button.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Page.IsTable" />
              <Binding Path="!HoldsTest" />
              <Binding Path="!IsFeature" />
              <Binding Path="Page.HasSeveralVersions" />
            </MultiBinding>
          </Button.IsVisible>
        </Button>
        <Button x:Name="RemovePart" Classes="link" FontSize="13" Content="{Binding RemovePartText}" Command="{Binding Page.RemovePartCommand}"
                IsVisible="{Binding IsFeature}" />
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
