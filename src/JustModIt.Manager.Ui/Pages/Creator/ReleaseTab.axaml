<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.ReleaseTab"
             x:DataType="creator:CellViewModel"
             ClipToBounds="False">
  <!-- The cards' shadows fall outside the control. -->
  <StackPanel Spacing="20" Margin="0,4,0,16">
    <!-- Another store's copy of the game, which the same project can cover. -->
    <ui:Callout x:Name="Offer" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.Info}" Message="{Binding Page.OfferText}"
                IsVisible="{Binding Page.HasOffer}" IsEnabled="{Binding !Page.Build.IsBuilding}" theme:Motion.Enter="True">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="outline small" Content="{Binding Page.OfferAction}" ui:ButtonAssist.Icon="{x:Static theme:Icons.Plus}" Command="{Binding Page.AddOfferCommand}" />
        <Button Classes="quiet small" Content="{x:Static loc:Strings.Creator_DismissOffer}" Command="{Binding Page.DismissOfferCommand}" />
      </StackPanel>
    </ui:Callout>

    <creator:CellPanel IsEnabled="{Binding !Page.Build.IsBuilding}" IsVisible="{Binding Page.ShowsCard}" />

    <!-- The parts over the versions; a cell opens its panel, and the arrows move between the cells. While a build runs the project
         stands still, but choosing a cell stays. -->
    <StackPanel x:Name="Table" Spacing="10" IsVisible="{Binding Page.ShowsTable}">
      <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Page.Heads}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <ui:PixelUniformGrid Columns="{Binding $parent[UserControl].((creator:CellViewModel)DataContext).Page.Heads.Count}" ColumnSpacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="caption" Margin="4,0" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <ItemsControl x:Name="Rows" ItemsSource="{Binding Page.Rows}" theme:Motion.Stagger="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="creator:CellRow">
            <Grid ColumnDefinitions="150,*" ColumnSpacing="10" Margin="0,0,0,10">
              <!-- An add-on's name is the author's to change; it takes the new one once the author leaves the box. -->
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" FontSize="14" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                           IsVisible="{Binding !IsFeature}" />
                <TextBox x:Name="PartName" Classes="partName" Text="{Binding TypedName, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding IsFeature}"
                         IsEnabled="{Binding !Page.Build.IsBuilding}"
                         AutomationProperties.Name="{x:Static loc:Strings.Creator_FeatureName}" />
                <TextBlock Classes="caption" Text="{Binding Caption}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding Mode}" IsVisible="{Binding IsFeature}" />
              </StackPanel>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <ui:PixelUniformGrid Columns="{Binding $parent[UserControl].((creator:CellViewModel)DataContext).Page.Heads.Count}" ColumnSpacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="creator:CellViewModel">
                    <Button Classes="cell" Classes.selected="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}"
                            Command="{Binding Page.SelectCellCommand}" CommandParameter="{Binding}">
                      <StackPanel Spacing="6">
                        <ui:StatusLine FontSize="13" LineHeight="20" Icon="{Binding Brief.Icon}" Tone="{Binding Brief.Tone}" Label="{Binding Brief.Label}"
                                       IsBusy="{Binding Brief.IsBusy}" />
                        <ProgressBar Classes="thin" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsComparing}"
                                     AutomationProperties.Name="{Binding Brief.Label}" />
                        <TextBlock Classes="caption" Text="{Binding Stage}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsComparing}" />
                        <TextBlock Classes="caption" Text="{Binding Brief.Detail}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Brief.Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Button Classes="outline small" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_Stop}" Command="{Binding CancelCommand}"
                                IsVisible="{Binding IsComparing}" IsEnabled="{Binding !Page.Build.IsBuilding}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- A folder dropped on the add-on's button makes an add-on of it. -->
      <WrapPanel ItemSpacing="10" LineSpacing="8" IsEnabled="{Binding !Page.Build.IsBuilding}">
        <Button x:Name="AddPart" Classes="outline addPart" Content="{x:Static loc:Strings.Creator_AddFeature}" ui:ButtonAssist.Icon="{x:Static theme:Icons.Plus}"
                Command="{Binding Page.AddPartCommand}" creator:FolderDrop.Command="{Binding Page.DropPartCommand}" />
        <Button x:Name="AddVersion" Classes="outline" Content="{x:Static loc:Strings.Creator_AddGameVersion}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.Plus}" Command="{Binding Page.AddVersionCommand}" />
      </WrapPanel>
    </StackPanel>

    <!-- The part's operations, or its steps in advanced mode, take the column, since their rows need its width. -->
    <Panel x:Name="PartView" IsVisible="{Binding Page.ShowsOperations}" IsEnabled="{Binding !Page.Build.IsBuilding}">
      <StackPanel Spacing="16" DataContext="{Binding Page.Review}" x:DataType="creator:ReviewViewModel">
        <!-- The part's mode beside its heading; a switch asks first, and a declined one leaves the pills as the mode is. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="6">
            <TextBlock Classes="h3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="lead" Text="{Binding Lead}" />
            <TextBlock Classes="lead" Text="{Binding VersionsLead}" IsVisible="{Binding VersionsLead, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Border Grid.Column="1" Classes="tabs" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="4" AutomationProperties.Name="{x:Static loc:Strings.Creator_ModeName}">
              <RadioButton x:Name="SimpleMode" Theme="{StaticResource SortPill}" GroupName="partMode" Content="{x:Static loc:Strings.Creator_ModeSimple}"
                           IsChecked="{Binding !IsAdvanced, Mode=OneWay}" Command="{Binding ToSimpleCommand}" />
              <RadioButton x:Name="AdvancedMode" Theme="{StaticResource SortPill}" GroupName="partMode" Content="{x:Static loc:Strings.Creator_ModeAdvanced}"
                           ToolTip.Tip="{x:Static loc:Strings.Creator_AdvancedHint}" IsChecked="{Binding IsAdvanced, Mode=OneWay}" Command="{Binding ToAdvancedCommand}" />
            </StackPanel>
          </Border>
        </Grid>
        <creator:RulesList />
        <creator:OperationList IsVisible="{Binding !IsAdvanced}" />
        <creator:StepList IsVisible="{Binding IsAdvanced}" />
      </StackPanel>
    </Panel>

    <creator:BuiltCard DataContext="{Binding Page}" IsEnabled="{Binding !Build.IsBuilding}" />
  </StackPanel>
</UserControl>
