<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.ReviewStepView"
             x:DataType="creator:ReviewViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="4">
      <Panel>
        <TextBlock Classes="h2" Text="{x:Static loc:Strings.Creator_ReviewTitle}" IsVisible="{Binding !IsAdvanced}" />
        <TextBlock Classes="h2" Text="{x:Static loc:Strings.Creator_StepsTitle}" IsVisible="{Binding IsAdvanced}" />
      </Panel>
      <TextBlock Classes="lead" Text="{Binding Lead}" />
    </StackPanel>

    <creator:RulesList />

    <creator:OperationList IsVisible="{Binding !IsAdvanced}" />

    <creator:StepList IsVisible="{Binding IsAdvanced}" />

    <creator:RuntimeList />

    <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="creator:FindingLine">
          <ui:Callout Classes="danger" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.CircleX}"
                      Message="{Binding Text}" Margin="0,0,0,8" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="soft" Padding="18,14,16,14" IsVisible="{Binding !IsAdvanced}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Classes="folderChip" Width="36" Height="36">
          <ui:Icon Data="{x:Static theme:Icons.ListOrdered}" Width="18" Height="18" />
        </Border>
        <TextBlock Grid.Column="1" Classes="bodyText" VerticalAlignment="Center">
          <Run Text="{x:Static loc:Strings.Creator_AdvancedHintTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <Run Text="{x:Static loc:Strings.Creator_AdvancedHint}" />
        </TextBlock>
        <Button Grid.Column="2" Classes="outline headerAction" Content="{x:Static loc:Strings.Creator_ToAdvancedButton}"
                ui:ButtonAssist.Icon="{x:Static theme:Icons.ListOrdered}" Command="{Binding ToAdvancedCommand}" />
      </Grid>
    </Border>

    <!-- The call to check everything before the package is built. -->
    <Border Classes="checkCard">
      <Panel>
        <Border Classes="checkGlow" />
        <StackPanel Spacing="16" Margin="24">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border Classes="workChip" CornerRadius="12">
              <ui:Icon Data="{x:Static theme:Icons.ListChecks}" Width="20" Height="20" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{x:Static loc:Strings.Creator_CheckTitle}" FontSize="18" LineHeight="26" FontWeight="Bold"
                         Foreground="{StaticResource TextStrongBrush}" />
              <TextBlock Classes="bodyL" Text="{Binding CheckText}" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Checklist}" Margin="54,0,0,0" ItemsPanel="{StaticResource StackItems8}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <ui:Icon Data="{x:Static theme:Icons.Check}" Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Grid.Column="1" Classes="bodyText" Foreground="{StaticResource TextEmphasisBrush}" Text="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="54,0,0,0">
            <Button x:Name="ConfirmButton" Classes="primary" Content="{x:Static loc:Strings.Creator_Confirm}" Margin="0,0,16,0"
                    ui:ButtonAssist.Icon="{x:Static theme:Icons.Check}" Command="{Binding ConfirmCommand}" />
            <TextBlock Classes="meta" Text="{x:Static loc:Strings.Creator_ConfirmNext}" VerticalAlignment="Center" IsVisible="{Binding CanConfirm}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MaxWidth="520" VerticalAlignment="Center" IsVisible="{Binding !CanConfirm}">
              <ui:Icon Data="{x:Static theme:Icons.Info}" Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top"
                       Foreground="{StaticResource DangerTextStrongBrush}" />
              <TextBlock Grid.Column="1" Classes="meta" Foreground="{StaticResource DangerTextStrongBrush}" Text="{Binding ConfirmBlocked}"
                         TextWrapping="Wrap" />
            </Grid>
          </WrapPanel>
        </StackPanel>
      </Panel>
    </Border>

    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
      <Button Classes="outline footerAction" Content="{x:Static loc:Strings.Creator_Back}" ui:ButtonAssist.Icon="{x:Static theme:Icons.ArrowLeft}"
              Command="{Binding BackCommand}" />
    </Grid>
  </StackPanel>
</UserControl>
