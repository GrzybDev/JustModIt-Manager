<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.BuiltCard"
             x:DataType="creator:ProjectPageViewModel"
             ClipToBounds="False">
  <!-- The cards' shadows fall outside the control. -->
  <StackPanel Spacing="20">
    <!-- The packages: those just built or, in a project opened again, the last build's; after a failed build the earlier one,
         said to be earlier. A file gone since its build says so. -->
    <Border Classes="creatorCard" Padding="24,20" IsVisible="{Binding Build.ShowsPackage}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <Border Classes="kind" Classes.success="{Binding Build.IsReadyToUse}" Width="48" Height="48" CornerRadius="12" Padding="0" HorizontalAlignment="Center">
          <Panel HorizontalAlignment="Center">
            <ui:Icon Data="{x:Static theme:Icons.CircleCheck}" Width="24" Height="24" IsVisible="{Binding Build.IsReadyToUse}" />
            <ui:Icon Data="{x:Static theme:Icons.FileX}" Width="24" Height="24" IsVisible="{Binding Build.IsGone}" />
            <ui:Icon Data="{x:Static theme:Icons.Clock}" Width="24" Height="24" IsVisible="{Binding Build.HasEarlierPackage}" />
          </Panel>
        </Border>
        <!-- A name wraps to a second line before it is cut, with its size right after it; the folder and the way to it stand under the
             packages, so a long list keeps its width. -->
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Classes="overline" Text="{Binding Build.EarlierText}" IsVisible="{Binding Build.HasEarlierPackage}" />
          <WrapPanel ItemSpacing="10" IsVisible="{Binding Build.IsReadyToUse}">
            <TextBlock Classes="overline" Text="{Binding Build.BuiltOverline}" VerticalAlignment="Center" />
            <TextBlock Classes="caption" Text="{Binding Build.BuiltAtText}" VerticalAlignment="Center" />
          </WrapPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" HorizontalAlignment="Left" IsVisible="{Binding !Build.HasSeveral}">
            <TextBlock Text="{Binding Build.ResultName}" FontSize="17" LineHeight="24" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Build.OutputPath}" />
            <Border Grid.Column="1" Classes="kind" Classes.warning="{Binding Build.IsGone}" VerticalAlignment="Center">
              <TextBlock Text="{Binding Build.ResultSize}" />
            </Border>
          </Grid>
          <TextBlock Classes="meta" Text="{Binding Build.ResultDetails}" TextWrapping="Wrap" IsVisible="{Binding !Build.HasSeveral}" />
          <!-- A run for several versions or parts made a package for each that differs. -->
          <ItemsControl x:Name="Packages" ItemsSource="{Binding Build.Packages}" IsVisible="{Binding Build.HasSeveral}" Margin="0,2,0,2">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="creator:BuiltRow">
                <!-- A package's name carries its part's, so the part and stores stand under it. -->
                <StackPanel Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" HorizontalAlignment="Left">
                    <TextBlock FontSize="14" LineHeight="20" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" Text="{Binding Name}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                    <Border Grid.Column="1" Classes="kind" Classes.warning="{Binding IsMissing}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Size}" />
                    </Border>
                  </Grid>
                  <TextBlock Classes="meta" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0">
            <TextBlock Classes="pathLine" Text="{Binding Build.ResultFolder}" VerticalAlignment="Center" ToolTip.Tip="{Binding Build.ResultFolder}" />
            <Button Grid.Column="1" Classes="outline headerAction" Content="{x:Static loc:Strings.Creator_Reveal}" ui:ButtonAssist.Icon="{x:Static theme:Icons.FolderOpen}"
                    Command="{Binding Build.RevealCommand}" IsVisible="{Binding !Build.IsGone}" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- After the build: what the site would say, the test in the game and the way to publish packages that are still there. A test
         package in the game keeps its test here whatever the packages, since its undo has no other place on the page. -->
    <StackPanel Spacing="20">
      <StackPanel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="Build.IsReadyToUse" />
          <Binding Path="Build.ShowsTest" />
        </MultiBinding>
      </StackPanel.IsVisible>
      <ItemsControl ItemsSource="{Binding Build.SiteWarnings}" IsVisible="{Binding Build.HasSiteWarnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <ui:Callout Classes="warning" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.TriangleAlert}"
                        Title="{x:Static loc:Strings.Creator_SiteWarningTitle}" Message="{Binding}" Margin="0,0,0,8" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="creatorCard" ClipToBounds="True">
        <StackPanel>
          <Border Padding="20,18" IsVisible="{Binding Build.ShowsTest}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Test.TestTitle}" FontSize="15" LineHeight="22" FontWeight="SemiBold" />
              <TextBlock Classes="bodyText" MaxWidth="760" HorizontalAlignment="Left" Text="{Binding Test.TestText}"
                         Classes.dangerText="{Binding Test.HasTestProblem}" />
              <!-- The add-ons go in after their base, each one the author leaves on. -->
              <StackPanel x:Name="TestFeatures" Spacing="8" Margin="0,10,0,0">
                <StackPanel.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="Test.OffersTestInstall" />
                    <Binding Path="Test.HasTestFeatures" />
                  </MultiBinding>
                </StackPanel.IsVisible>
                <TextBlock Classes="caption" Text="{x:Static loc:Strings.Creator_TestFeatures}" />
                <ItemsControl ItemsSource="{Binding Test.TestFeatures}" ItemsPanel="{StaticResource WrapItems8}"
                              AutomationProperties.Name="{x:Static loc:Strings.Creator_TestFeatures}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="creator:TestFeature">
                      <ToggleButton Theme="{StaticResource OptionPill}" Content="{Binding Part}" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Part}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="8" Margin="0,10,0,0" IsVisible="{Binding Test.IsTestRunning}">
                <TextBlock Classes="meta" Foreground="{StaticResource TextBodyBrush}" Text="{Binding Test.TestProgress}" />
                <ProgressBar Classes="thin" Maximum="1" MaxWidth="420" HorizontalAlignment="Left" Value="{Binding Test.TestFraction}"
                             IsIndeterminate="{Binding Test.TestFraction, Converter={x:Static ObjectConverters.IsNull}}"
                             AutomationProperties.Name="{Binding Test.TestProgress}" />
              </StackPanel>
              <WrapPanel ItemSpacing="12" LineSpacing="8" Margin="0,10,0,0">
                <Button x:Name="TestButton" Classes="primary compact" Content="{x:Static loc:Strings.Creator_TestInstall}" IsVisible="{Binding Test.OffersTestInstall}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.Download}" Command="{Binding Test.InstallTestCommand}" />
                <Button Classes="primary compact" Content="{x:Static loc:Strings.Creator_Launch}" ui:ButtonAssist.Icon="{x:Static theme:Icons.Play}"
                        Command="{Binding Test.LaunchCommand}">
                  <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="Test.IsTestInstalled" />
                      <Binding Path="Test.CanLaunch" />
                    </MultiBinding>
                  </Button.IsVisible>
                </Button>
                <Button x:Name="UndoTestButton" Classes="outline" Content="{x:Static loc:Strings.Creator_UndoTest}" IsVisible="{Binding Test.IsTestInstalled}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.RotateCcw}" Command="{Binding Test.UndoTestCommand}" />
                <Button Classes="quiet" Content="{x:Static loc:Strings.Creator_TestAgain}" IsVisible="{Binding Test.WasTested}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.Download}" Command="{Binding Test.InstallTestCommand}" />
              </WrapPanel>
              <Button x:Name="TestTogether" Classes="link" Margin="0,6,0,0" HorizontalAlignment="Left"
                      Content="{x:Static loc:Strings.Creator_TestTogether}" IsVisible="{Binding Test.OffersTestInstall}"
                      Command="{Binding Test.InstallTestTogetherCommand}" />
            </StackPanel>
          </Border>
          <Border Classes="divider" Opacity="0.6">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="Build.IsReadyToUse" />
                <Binding Path="Build.ShowsTest" />
              </MultiBinding>
            </Border.IsVisible>
          </Border>
          <Border Padding="20,18" IsVisible="{Binding Build.IsReadyToUse}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Build.PublishTitle}" FontSize="15" LineHeight="22" FontWeight="SemiBold" />
              <TextBlock Classes="bodyText" MaxWidth="760" HorizontalAlignment="Left" Text="{Binding Build.PublishText}" />
              <TextBlock Classes="meta" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="{Binding Build.SiteStoresText}" IsVisible="{Binding Build.SiteStoresText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <!-- Once the package was tried in the game, publishing it is the next thing to do. -->
              <Button Classes="link" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_OpenDashboard}"
                      ui:ButtonAssist.Icon="{x:Static theme:Icons.ExternalLink}" Command="{Binding Build.OpenSiteCommand}" IsVisible="{Binding !Test.WasTested}" />
              <Button Classes="primary compact" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_OpenDashboard}"
                      ui:ButtonAssist.Icon="{x:Static theme:Icons.ExternalLink}" ui:ButtonAssist.IconAfter="True" Command="{Binding Build.OpenSiteCommand}"
                      IsVisible="{Binding Test.WasTested}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
