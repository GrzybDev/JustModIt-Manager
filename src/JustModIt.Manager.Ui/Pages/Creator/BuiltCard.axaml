<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="using:JustModIt.Manager.Ui.Pages.Creator"
             xmlns:ui="using:JustModIt.Manager.Ui.Controls"
             xmlns:theme="using:JustModIt.Manager.Ui.Theme"
             xmlns:loc="using:JustModIt.Manager.Localization"
             x:Class="JustModIt.Manager.Ui.Pages.Creator.BuiltCard"
             x:DataType="creator:ProjectPageViewModel"
             ClipToBounds="False">
  <!-- The cards' shadows fall outside the control. -->
  <StackPanel Spacing="20">
    <!-- The package: the one just built, or after a failed build the earlier one, said to be earlier. -->
    <Border Classes="creatorCard" Padding="24,20" IsVisible="{Binding Build.ShowsPackage}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <Border Classes="kind" Classes.success="{Binding Build.IsBuilt}" Width="48" Height="48" CornerRadius="12" Padding="0" HorizontalAlignment="Center">
          <Panel HorizontalAlignment="Center">
            <ui:Icon Data="{x:Static theme:Icons.CircleCheck}" Width="24" Height="24" IsVisible="{Binding Build.IsBuilt}" />
            <ui:Icon Data="{x:Static theme:Icons.Clock}" Width="24" Height="24" IsVisible="{Binding Build.HasEarlierPackage}" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Classes="overline" Text="{Binding Build.EarlierText}" IsVisible="{Binding Build.HasEarlierPackage}" />
          <TextBlock Classes="overline" Text="{x:Static creator:BuiltCard.BuiltOverline}" IsVisible="{Binding Build.IsBuilt}" />
          <WrapPanel ItemSpacing="10">
            <TextBlock Text="{Binding Build.ResultName}" FontSize="17" LineHeight="24" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}" />
            <Border Classes="kind" VerticalAlignment="Center">
              <TextBlock Text="{Binding Build.ResultSize}" />
            </Border>
          </WrapPanel>
          <TextBlock Classes="meta" Text="{Binding Build.ResultDetails}" TextWrapping="Wrap" />
          <TextBlock Classes="pathLine" Text="{Binding Build.ResultFolder}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Build.ResultFolder}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="outline" Content="{x:Static loc:Strings.Creator_Reveal}" ui:ButtonAssist.Icon="{x:Static theme:Icons.FolderOpen}"
                Command="{Binding Build.RevealCommand}" />
      </Grid>
    </Border>

    <!-- After the build: what the site would say, the test in the game and the way to publish. -->
    <StackPanel Spacing="20" IsVisible="{Binding Build.IsBuilt}">
      <ItemsControl ItemsSource="{Binding Build.SiteWarnings}" IsVisible="{Binding Build.HasSiteWarnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <ui:Callout Classes="warning" MaxWidth="Infinity" HorizontalAlignment="Stretch" Icon="{x:Static theme:Icons.TriangleAlert}"
                        Title="{x:Static loc:Strings.Creator_SiteWarningTitle}" Message="{Binding}" Margin="0,0,0,8" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="creatorCard" ClipToBounds="True">
        <StackPanel>
          <Border Padding="20,18">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Test.TestTitle}" FontSize="15" LineHeight="22" FontWeight="SemiBold" />
              <TextBlock Classes="bodyText" MaxWidth="760" HorizontalAlignment="Left" Text="{Binding Test.TestText}"
                         Classes.dangerText="{Binding Test.HasTestProblem}" />
              <StackPanel Spacing="8" Margin="0,10,0,0" IsVisible="{Binding Test.IsTestRunning}">
                <TextBlock Classes="meta" Foreground="{StaticResource TextBodyBrush}" Text="{Binding Test.TestProgress}" />
                <ProgressBar Classes="thin" Maximum="1" MaxWidth="420" HorizontalAlignment="Left" Value="{Binding Test.TestFraction}"
                             IsIndeterminate="{Binding Test.TestFraction, Converter={x:Static ObjectConverters.IsNull}}"
                             AutomationProperties.Name="{Binding Test.TestProgress}" />
              </StackPanel>
              <WrapPanel ItemSpacing="12" LineSpacing="8" Margin="0,10,0,0">
                <Button x:Name="TestButton" Classes="primary compact" Content="{x:Static loc:Strings.Creator_TestInstall}" IsVisible="{Binding Test.OffersTestInstall}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.Download}" Command="{Binding Test.InstallTestCommand}" CommandParameter="{Binding Build.OutputPath}" />
                <Button Classes="primary compact" Content="{x:Static loc:Strings.Creator_Launch}" ui:ButtonAssist.Icon="{x:Static theme:Icons.Play}"
                        Command="{Binding Test.LaunchCommand}">
                  <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="Test.IsTestInstalled" />
                      <Binding Path="Test.CanLaunch" />
                    </MultiBinding>
                  </Button.IsVisible>
                </Button>
                <Button x:Name="UndoTestButton" Classes="outline" Content="{x:Static loc:Strings.Creator_UndoTest}" IsVisible="{Binding Test.IsTestInstalled}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.RotateCcw}" Command="{Binding Test.UndoTestCommand}" />
                <Button Classes="quiet" Content="{x:Static loc:Strings.Creator_TestAgain}" IsVisible="{Binding Test.WasTested}"
                        ui:ButtonAssist.Icon="{x:Static theme:Icons.Download}" Command="{Binding Test.InstallTestCommand}" CommandParameter="{Binding Build.OutputPath}" />
              </WrapPanel>
              <Button x:Name="TestTogether" Classes="link" Margin="0,6,0,0" HorizontalAlignment="Left"
                      Content="{x:Static loc:Strings.Creator_TestTogether}" IsVisible="{Binding Test.OffersTestInstall}"
                      Command="{Binding Test.InstallTestTogetherCommand}" CommandParameter="{Binding Build.OutputPath}" />
            </StackPanel>
          </Border>
          <Border Classes="divider" Opacity="0.6" />
          <Border Padding="20,18">
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static loc:Strings.Creator_PublishTitle}" FontSize="15" LineHeight="22" FontWeight="SemiBold" />
              <TextBlock Classes="bodyText" MaxWidth="760" HorizontalAlignment="Left" Text="{Binding Build.PublishText}" />
              <!-- Once the package was tried in the game, publishing it is the next thing to do. -->
              <Button Classes="link" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_OpenDashboard}"
                      ui:ButtonAssist.Icon="{x:Static theme:Icons.ExternalLink}" Command="{Binding Build.OpenSiteCommand}" IsVisible="{Binding !Test.WasTested}" />
              <Button Classes="primary compact" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static loc:Strings.Creator_OpenDashboard}"
                      ui:ButtonAssist.Icon="{x:Static theme:Icons.ExternalLink}" ui:ButtonAssist.IconAfter="True" Command="{Binding Build.OpenSiteCommand}"
                      IsVisible="{Binding Test.WasTested}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
