<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CsWin32's NativeAOT setup: run as a build task, so .NET's own source generators marshal what it generates,
         COM interfaces included. -->
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Interop\NativeMethods.txt" />
    <AdditionalFiles Include="Interop\NativeMethods.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustModIt.Manager.Core\JustModIt.Manager.Core.csproj" />
  </ItemGroup>
</Project>
